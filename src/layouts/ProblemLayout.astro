---
/**
 * The universal problem page. Every problem, from malaria to clean power,
 * renders through this one layout; only the data changes.
 */
import BaseLayout from './BaseLayout.astro';
import ReportCard from '../components/ReportCard.astro';
import ReviewBadge from '../components/ReviewBadge.astro';
import Icon from '../components/Icon.astro';
import ProblemHeader from '../components/ProblemHeader.astro';
import type { Problem } from '../data/problems';
import { KIND_LABEL, KINDS, type ProblemData } from '../lib/problemData';
import type { Report } from '../lib/reports';
import { reportPath } from '../lib/reports';
import { newReportUrl } from '../lib/publish';
import { gh, url } from '../site.config';

interface Props { problem: Problem; reports: Report[]; data: ProblemData | null }
const { problem, reports, data } = Astro.props;
const blockers = data ? data.order.filter((id) => data.nodes[id].blocker) : [];
const subs = data ? data.nodes[data.root].children : [];
const stepCount = data ? data.order.filter((id) => data.nodes[id].type === 'step').length : 0;
const uncovered = subs.filter((id) => !data!.actorsOn[id]?.length);
const latest = reports[0];
const withHeadline = reports.find((r) => r.data.headline);
const folder = `problems/${problem.slug}/reports`;
const issueUrl = gh.issues(
  `Problem ${problem.number}: `,
  `Problem: ${problem.number}. ${problem.title}\n\nWhat should a report cover, or which source is missing?\n`,
);
---
<BaseLayout title={`${problem.number}. ${problem.title}`} description={latest?.data.summary}>
  <div class="wrap">
    <ProblemHeader problem={problem} current="overview" counts={{ reports: reports.length, steps: data?.order.length, organisations: data?.actors.length }} />

    <div class="grid">
      <div class="main">
        <section class="headline panel" aria-label="Where it stands">
          {withHeadline?.data.headline ? (
            <>
              <p class="numeral-xl">{withHeadline.data.headline.value}</p>
              <p class="label muted">{withHeadline.data.headline.label}</p>
              <p class="body-sm from">
                From <a href={url(reportPath(withHeadline))}>{withHeadline.data.title}</a>
                <ReviewBadge status={withHeadline.data.status} reviewers={withHeadline.data.reviewers} />
              </p>
            </>
          ) : (
            <p class="body muted">No report yet. We don't have a sourced figure for where this problem stands.</p>
          )}
        </section>

        <div class="actions">
          <a class="btn btn-primary" href={newReportUrl(problem)}><Icon name="plus" />Publish a report on GitHub</a>
          <a class="btn btn-secondary" href={gh.tree(folder)}><Icon name="github" />Reports folder</a>
          <a class="btn btn-ghost" href={issueUrl}>Suggest a topic or source</a>
        </div>

        {data && (
          <div class="two">
            <a class="panel sum" href={url(`/problems/${problem.slug}/map/`)}>
              <p class="label muted">Tree map</p>
              <p class="subheading">{subs.length} sub-goals, {stepCount} steps, {data.projects.length} projects</p>
              <p class="body-sm muted">Sub-goals: {subs.filter((id) => data.nodes[id].status === 'open').length} open · {subs.filter((id) => data.nodes[id].status === 'in_progress').length} in progress · {subs.filter((id) => ['demonstrated', 'solved'].includes(data.nodes[id].status)).length} demonstrated or solved. Steps and most projects come from the scanners.</p>
              {blockers.length > 0 && (
                <div><p class="label muted">Main blockers</p><ul class="plain body-sm">{blockers.map((id) => <li>{data.nodes[id].title}</li>)}</ul></div>
              )}
              <span class="go body-sm">Open the tree map <Icon name="arrow" size={12} /></span>
            </a>
            <a class="panel sum" href={url(`/problems/${problem.slug}/network/`)}>
              <p class="label muted">Who's working on it</p>
              <p class="subheading">{data.actors.length} organisations</p>
              <p class="body-sm muted">{KINDS.filter((k) => data.actors.some((a) => a.kind === k)).map((k) => `${data.actors.filter((a) => a.kind === k).length} ${KIND_LABEL[k].toLowerCase()}`).join(' · ')}</p>
              <div><p class="label muted">Sub-goals with nobody in the curated network</p><p class="body-sm">{uncovered.length ? uncovered.map((id) => data.nodes[id].title).join('; ') : 'None'}</p></div>
              <span class="go body-sm">Open the network <Icon name="arrow" size={12} /></span>
            </a>
          </div>
        )}

        <section class="reports">
          <h2 class="heading">Reports <span class="data muted">{reports.length}</span></h2>
          {reports.length === 0 && <p class="body muted">Nobody has published a report on this problem yet. You could be first.</p>}
          {reports.map((r, i) => <ReportCard report={r} latest={i === 0} />)}
        </section>
      </div>

      <aside class="side">
        <div class="panel how">
          <h2 class="subheading">How publishing works</h2>
          <ol class="body-sm">
            <li><strong>Write.</strong> "Publish a report" opens GitHub with the report template in <code class="data-sm">{folder}/</code>. Tree map steps and organisations are files too.</li>
            <li><strong>Propose.</strong> Saving it there opens a pull request. The build check validates the file.</li>
            <li><strong>Review.</strong> Reviewers comment and approve. Set <code class="data-sm">status: reviewed</code> once an expert has checked it.</li>
            <li><strong>Publish.</strong> Merging to <code class="data-sm">main</code> rebuilds and deploys the site.</li>
          </ol>
        </div>
        <div class="panel">
          <h2 class="subheading">Every report covers</h2>
          <ul class="body-sm muted plain">
            <li>Where we are now</li><li>What has to be true</li><li>Main bottlenecks</li><li>Paths</li>
            <li>What would change this assessment</li><li>What you can do</li><li>Gaps</li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
<style>
  .grid { margin-top: var(--space-8); display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: var(--space-6); align-items: start; }
  @media (max-width: 900px) { .grid, .two { grid-template-columns: 1fr; } }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6); }
  .sum { display: grid; gap: var(--space-2); align-content: start; color: var(--ink); text-decoration: none; }
  .sum:hover { border-color: var(--line-strong); color: var(--ink); }
  .sum:hover .go { text-decoration: underline; }
  .go { color: var(--signal); display: inline-flex; align-items: center; gap: var(--space-1); }
  .main, .side, .reports { display: grid; gap: var(--space-6); }
  .reports { gap: var(--space-4); margin-top: var(--space-2); }
  .headline { display: grid; gap: var(--space-1); }
  .from { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); margin-top: var(--space-2); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .how ol { margin: var(--space-3) 0 0; padding-left: var(--space-4); display: grid; gap: var(--space-2); }
  .plain { list-style: none; margin: var(--space-3) 0 0; padding: 0; display: grid; gap: var(--space-1); }
  code { background: var(--surface-2); padding: 0 var(--space-1); border-radius: var(--radius-sm); }
</style>
