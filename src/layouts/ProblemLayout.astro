---
/**
 * The universal problem overview: a quick summary of every section, the leading
 * ongoing projects (the main place to act), and the scenario simulator that shows
 * how those projects change the chance of reaching the goal.
 */
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ProblemHeader from '../components/ProblemHeader.astro';
import LeadingProjects from '../components/LeadingProjects.astro';
import Simulator from '../components/Simulator.astro';
import ForecastGraph from '../components/ForecastGraph.astro';
import IdeaLab from '../components/IdeaLab.astro';
import { buildForecast } from '../lib/forecast';
import { buildIdeaContext } from '../lib/ideation';
import NoData from '../components/NoData.astro';
import type { Problem } from '../data/problems';
import type { ProblemData } from '../lib/problemData';
import { getField } from '../lib/field';
import { getRelations, GROUP_OF, GROUP_LABEL, GROUP_ORDER } from '../lib/relations';
import { buildModel, simulate, headline, pBy, DEFAULT_SCENARIO } from '../lib/simulate';
import { url } from '../site.config';

interface Props { problem: Problem; data: ProblemData | null }
const { problem, data } = Astro.props;
const field = getField(problem.slug);
const rel = getRelations(problem.slug);
const base = `/problems/${problem.slug}`;

const subs = data ? data.nodes[data.root].children : [];
const stepCount = data ? data.order.filter((id) => data.nodes[id].type === 'step').length : 0;
const blockers = data ? subs.filter((id) => data.nodes[id].blocker) : [];
// Built once, shared by the forecast graph and the ideation assistant.
const simModel = data ? buildModel(data) : null;
const forecast = data ? buildForecast(simModel!, data) : null;
const sim = data ? (() => {
  const m = simModel!;
  const withP = simulate(m, DEFAULT_SCENARIO);
  const without = simulate(m, { ...DEFAULT_SCENARIO, includeTracked: false });
  return { headline: headline(withP), with: pBy(withP, 2050), without: pBy(without, 2050) };
})() : null;
const orgs = field ? field.summary.totals.organisations : data?.actors.length ?? 0;
const byGroup = field ? GROUP_ORDER.map((g) => [g, field.orgs.filter((o) => (GROUP_OF[o.type] ?? 'policy') === g).length] as const) : [];
const trend = field?.summary.trends[data?.root ?? ''];
const growth = trend && trend.length > 1 && trend[0][1] ? Math.round(((trend[trend.length - 1][1] - trend[0][1]) / trend[0][1]) * 100) : null;
const pct = (x: number) => `${Math.round(x * 100)}%`;
const ideaCtx = data && forecast ? buildIdeaContext(data, field, rel, forecast, problem.title, problem.number) : null;
---
<BaseLayout title={`${problem.number}. ${problem.title}`} description={`Projects, forecast and state of the field for: ${problem.title}`}>
  <div class="wrap">
    <ProblemHeader problem={problem} current="overview" counts={{ steps: data?.order.length, organisations: data?.actors.length }} />

    {!data ? <NoData problem={problem} what="map" /> : (
      <div class="page">
        <section class="summary" aria-label="Summary">
          <a class="card" href="#simulator">
            <p class="label muted">Forecast</p>
            <p class="big">{sim!.headline}</p>
            <p class="body-sm muted">With the tracked projects: <span class="data">{pct(sim!.with)}</span> by 2050, up from <span class="data">{pct(sim!.without)}</span> without them. Illustrative model.</p>
          </a>
          <a class="card" href={url(`${base}/map/`)}>
            <p class="label muted">Tree map</p>
            <p class="big">{subs.length} sub-goals · {stepCount} steps · {data.projects.length} projects</p>
            <p class="body-sm muted">{blockers.length ? <>Main blockers: {blockers.map((id) => data.nodes[id].title).join('; ')}.</> : 'No main blocker marked.'}</p>
          </a>
          <a class="card" href={url(`${base}/network/`)}>
            <p class="label muted">Who's working on it</p>
            <p class="big">{orgs.toLocaleString('en')} organisations</p>
            <p class="body-sm muted">{byGroup.length ? byGroup.map(([g, n]) => `${n.toLocaleString('en')} ${GROUP_LABEL[g].toLowerCase()}`).join(' · ') : `${data.actors.length} in the curated network`}{rel ? ` · ${rel.edges.length} relationships mapped` : ''}.</p>
          </a>
          <a class="card" href={url(`${base}/field/`)}>
            <p class="label muted">State of the field</p>
            <p class="big">{field ? `${field.summary.totals.kept.toLocaleString('en')} items` : 'Not scanned yet'}</p>
            <p class="body-sm muted">{field ? <>Papers, code, startups, investors and news from {Object.keys(field.summary.sources).length} open sources{growth !== null ? <>; research output {growth >= 0 ? 'up' : 'down'} <span class="data">{Math.abs(growth)}%</span> since {trend![0][0]}</> : ''}.</> : 'Run the field scanner to fill this in.'}</p>
          </a>
        </section>

        <LeadingProjects data={data} problem={problem} />

        <IdeaLab ctx={ideaCtx!} model={simModel!} problem={problem} />

        <section id="simulator" class="simsec">
          <div class="simhead">
            <h2 class="display-l">Forecast</h2>
            <p class="body muted">The different ways from today to the goal, simulated thousands of times: which projects to keep going, where new ones should start, and what each path is likely to reach.</p>
          </div>
          <ForecastGraph data={data} problem={problem} forecast={forecast!} />
          <details class="own">
            <summary class="subheading">Build your own scenario</summary>
            <p class="body-sm muted">Set the target year, how often projects succeed, and how many new projects each sub-goal gets, and see the forecast change.</p>
            <Simulator data={data} problem={problem} />
          </details>
        </section>
      </div>
    )}
  </div>
</BaseLayout>
<style>
  .page { display: grid; gap: var(--space-16); margin-top: var(--space-8); }
  .page > * { min-width: 0; }
  .summary { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-4); }
  @media (max-width: 1000px) { .summary { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .summary { grid-template-columns: minmax(0, 1fr); } }
  .card { min-width: 0; overflow-wrap: anywhere; display: grid; gap: var(--space-2); align-content: start; background: var(--surface-1); border: var(--stroke-hairline) solid var(--line); border-radius: var(--radius-md); padding: var(--space-4); color: var(--ink); text-decoration: none; }
  .card:hover { border-color: var(--line-strong); color: var(--ink); }
  .big { font-family: var(--font-sans); font-size: 18px; line-height: 24px; font-weight: 600; }
  .simsec { display: grid; gap: var(--space-6); }
  .simhead { display: grid; gap: var(--space-2); max-width: 70ch; }
  .own { display: grid; gap: var(--space-4); border-top: var(--stroke-hairline) solid var(--line); padding-top: var(--space-6); }
  .own > summary { cursor: pointer; }
  .own[open] > summary { margin-bottom: var(--space-4); }
</style>
