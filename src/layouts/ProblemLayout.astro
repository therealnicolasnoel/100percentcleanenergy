---
/**
 * Act: the problem's front page. Where it stands in one sentence, three next steps,
 * the leading projects, and the forecast of where different paths lead.
 */
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ProblemHeader from '../components/ProblemHeader.astro';
import LeadingProjects from '../components/LeadingProjects.astro';
import ForecastGraph from '../components/ForecastGraph.astro';
import NoData from '../components/NoData.astro';
import type { Problem } from '../data/problems';
import type { ProblemData, Project } from '../lib/problemData';
import { getField } from '../lib/field';
import { buildModel, isOngoing, projectWeight, projectSuccess } from '../lib/simulate';
import { buildForecast } from '../lib/forecast';
import { url } from '../site.config';

interface Props { problem: Problem; data: ProblemData | null }
const { problem, data } = Astro.props;
const field = getField(problem.slug);
const F = data ? buildForecast(buildModel(data), data) : null;
const main = F?.branches.find((b) => b.kind === 'main');
const best = F?.branches.find((b) => b.kind === 'best');
const t = (id: string) => data?.nodes[id]?.title ?? id;
const pct = (x: number) => `${Math.round(x * 100)}%`;
const yr = (y: number) => (Number.isFinite(y) && F && y < F.start + 75 ? String(Math.round(y)) : 'not within 75 years');

const createUrl = (subgoal: string, step?: string) =>
  url(`/problems/${problem.slug}/projects/new/?${new URLSearchParams({ subgoal, ...(step ? { step } : {}) })}`);
const ext = (p: Project) => (p.url?.startsWith('/') ? {} : { target: '_blank', rel: 'noopener' });

const starts = best ? [...best.starts].sort((a, b) => b.count - a.count).slice(0, 3) : [];
const join3: Project[] = data ? data.projects.filter((p) => isOngoing(p) && p.url).sort((a, b) => projectWeight(b) * projectSuccess(b) - projectWeight(a) * projectSuccess(a)).slice(0, 3) : [];
const keep = F?.critical.slice(0, 3) ?? [];
const projByKey = new Map((data?.projects ?? []).map((p) => [p.key, p]));
---
<BaseLayout title={`${problem.number}. ${problem.title}`} description={`What to do next on: ${problem.title}`}>
  <div class="wrap">
    <ProblemHeader problem={problem} current="act" />

    {!data || !F || !main || !best ? <NoData problem={problem} what="map" /> : (
      <div class="page">
        <section class="status">
          <p class="lead">
            With today's <a href="#projects">{data.projects.length} tracked projects</a> there's a <strong>{pct(main.p)}</strong> chance of reaching this by {F.target}, and half of the simulated futures get there by <strong>{yr(main.median)}</strong>. What holds it back most: <a href={url(`/problems/${problem.slug}/map/#${main.bottleneck}`)}>{t(main.bottleneck!)}</a>.
          </p>
          <p class="body-sm muted">
            {field ? `${field.summary.totals.organisations.toLocaleString('en')} organisations and ${field.summary.totals.kept.toLocaleString('en')} papers, repositories, startups and grants are mapped in ` : 'See '}<a href={url(`/problems/${problem.slug}/field/`)}>What's happening</a>. Forecasts are an <a href="#forecast">illustrative model</a>.
          </p>
        </section>

        <section class="next" aria-labelledby="next-h">
          <h2 id="next-h" class="heading">Next steps</h2>
          <div class="cards">
            <article class="card primary">
              <p class="num data">1</p>
              <h3 class="subheading">Start a project where it helps most</h3>
              <p class="body-sm muted">New projects here would raise the chance by {F.target} from {pct(main.p)} to {pct(best.p)}.</p>
              <ul class="plain">
                {starts.map((s) => (
                  <li>
                    <a class="body-sm" href={url(`/problems/${problem.slug}/map/#${s.unit}`)}>{t(s.unit)}</a>
                    <span class="body-sm muted"> · {t(s.subgoal)}</span>
                    <a class="create body-sm" href={createUrl(s.subgoal, s.unit !== s.subgoal ? s.unit : undefined)}><Icon name="plus" size={12} />Open a project here</a>
                  </li>
                ))}
              </ul>
            </article>
            <article class="card">
              <p class="num data">2</p>
              <h3 class="subheading">Join a leading project</h3>
              <p class="body-sm muted">Active projects you can contribute to, back or partner with today.</p>
              <ul class="plain">
                {join3.map((p) => (
                  <li><a class="body-sm" href={p.url!} {...ext(p)}>{p.title}</a><span class="body-sm muted"> · {t(p.step ?? p.subgoal)}</span></li>
                ))}
              </ul>
              <a class="more body-sm" href="#projects">All leading projects <Icon name="arrow" size={12} /></a>
            </article>
            <article class="card">
              <p class="num data">3</p>
              <h3 class="subheading">Keep key projects going</h3>
              <p class="body-sm muted">The tracked projects the forecast depends on most.</p>
              <ul class="plain">
                {keep.length ? keep.map((c) => {
                  const p = projByKey.get(c.key);
                  return <li>{p?.url ? <a class="body-sm" href={p.url} {...ext(p)}>{c.title}</a> : <span class="body-sm">{c.title}</span>}<span class="data-sm muted"> · −{c.drop.toFixed(1)} pts if it stops</span></li>;
                }) : <li class="body-sm muted">No single project stands out yet.</li>}
              </ul>
            </article>
          </div>
        </section>

        <div id="projects"><LeadingProjects data={data} problem={problem} limit={6} /></div>

        <section id="forecast" class="fc-sec">
          <div class="head">
            <h2 class="heading">Forecast</h2>
            <p class="body-sm muted">Each line is one way forward, simulated thousands of times. Select a line to see where its projects start and when the goal is reached.</p>
          </div>
          <ForecastGraph data={data} problem={problem} forecast={F} />
        </section>
      </div>
    )}
  </div>
</BaseLayout>
<style>
  .page { display: grid; gap: var(--space-12); margin-top: var(--space-8); }
  .page > * { min-width: 0; }
  .status { display: grid; gap: var(--space-2); max-width: 76ch; }
  .lead { font-family: var(--font-serif); font-size: 22px; line-height: 32px; }
  .lead strong { font-family: var(--font-mono); font-weight: 500; font-size: 20px; }
  .next { display: grid; gap: var(--space-4); }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
  @media (max-width: 900px) { .cards { grid-template-columns: minmax(0, 1fr); } }
  .card { display: grid; gap: var(--space-2); align-content: start; background: var(--surface-1); border: var(--stroke-hairline) solid var(--line); border-radius: var(--radius-md); padding: var(--space-4); }
  .card.primary { border: var(--stroke-path) solid var(--ink); }
  .num { width: 24px; height: 24px; border-radius: var(--radius-pill); background: var(--surface-2); display: grid; place-items: center; }
  .card.primary .num { background: var(--ink); color: var(--surface-0); }
  .plain { list-style: none; margin: var(--space-1) 0 0; padding: 0; display: grid; gap: var(--space-2); }
  .create { display: inline-flex; gap: 2px; align-items: center; margin-left: var(--space-2); white-space: nowrap; font-weight: 500; }
  .more { display: inline-flex; gap: var(--space-1); align-items: center; }
  .fc-sec { display: grid; gap: var(--space-4); }
  .head { display: grid; gap: var(--space-1); max-width: 70ch; }
</style>
