---
/** Shared header for every problem page: the problem and its tabs. */
import type { Problem } from '../data/problems';
import { url } from '../site.config';

interface Props {
  problem: Problem;
  current: 'act' | 'projects' | 'plan' | 'happening';
}
const { problem, current } = Astro.props;
const base = `/problems/${problem.slug}/`;
const tabs = [
  { id: 'act', label: 'Act', hint: 'What to do next', href: base },
  { id: 'projects', label: 'Projects', hint: 'Open one, join one', href: `${base}projects/` },
  { id: 'plan', label: 'Plan', hint: 'Sub-goals, steps, projects', href: `${base}map/` },
  { id: 'happening', label: "What's happening", hint: 'Who is involved, latest work', href: `${base}field/` },
];
---
<header class="ph">
  <a class="back body-sm" href={url('/')}>← All problems</a>
  <p class="label muted"><span class="data">Problem {problem.number}</span> · {problem.category}</p>
  <h1 class="display-l">{problem.title}</h1>
  <nav class="tabs" aria-label="Problem pages">
    {tabs.map((t) => (
      <a class:list={['tab', { on: t.id === current }]} href={url(t.href)} aria-current={t.id === current ? 'page' : undefined}>
        <span class="t">{t.label}</span>
        <span class="h">{t.hint}</span>
      </a>
    ))}
  </nav>
</header>
<style>
  .ph { display: grid; gap: var(--space-2); padding-top: var(--space-6); }
  .back { color: var(--ink-muted); text-decoration: none; margin-bottom: var(--space-4); justify-self: start; }
  .back:hover { color: var(--signal); }
  h1 { max-width: 900px; }
  .tabs { display: flex; flex-wrap: wrap; gap: var(--space-1); border-bottom: var(--stroke-hairline) solid var(--line); margin-top: var(--space-4); }
  .tab { display: grid; gap: 0; padding: var(--space-2) var(--space-4) var(--space-3); color: var(--ink); text-decoration: none; border-bottom: var(--stroke-path) solid transparent; margin-bottom: -1px; }
  .tab:hover { background: var(--surface-2); color: var(--ink); }
  .tab.on { border-bottom-color: var(--signal); }
  .t { font-size: 15px; line-height: 22px; font-weight: 600; }
  .h { font-size: 12px; line-height: 16px; color: var(--ink-muted); }
  @media (max-width: 560px) { .h { display: none; } .tab { padding: var(--space-2) var(--space-3); } }
</style>
