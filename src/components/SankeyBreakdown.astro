---
/**
 * Breakdown of who is working on a problem, as a multi-stage Sankey:
 * organisation types → groups → all organisations → sub-goals → steps.
 * Band widths are proportional to the number of organisations.
 */
import { buildSankey, bandPath } from '../lib/relations';
import type { Field } from '../lib/field';
import type { ProblemData } from '../lib/problemData';
import type { Problem } from '../data/problems';
import { url } from '../site.config';

interface Props { field: Field | null; data: ProblemData; problem: Problem }
const { field, data, problem } = Astro.props;
const S = buildSankey(field, data);
const byId = new Map(S.nodes.map((n) => [n.id, n]));
const fmt = (v: number) => (v >= 10 ? Math.round(v).toLocaleString('en') : v >= 1 ? v.toFixed(1).replace(/\.0$/, '') : v.toFixed(1));
const pct = (v: number) => `${Math.round((v / S.total) * 100)}%`;
---
<figure class="sk" data-sankey>
  <div class="scroll">
    <svg viewBox={`0 0 ${S.width} ${S.height}`} width={S.width} height={S.height} role="img" aria-labelledby="sk-title sk-desc">
      <title id="sk-title">Who is working on {problem.title}</title>
      <desc id="sk-desc">{Math.round(S.total)} organisations, by type and group on the left, flowing into the sub-goals and steps of the tree map on the right.</desc>
      <defs>
        <linearGradient id="sk-mid" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="var(--viz-1)" />
          <stop offset="1" stop-color="var(--viz-2)" />
        </linearGradient>
      </defs>
      <g class="bands">
        {S.links.map((l) => {
          const s = byId.get(l.source)!, t = byId.get(l.target)!;
          return (
            <path d={bandPath(l, s, t, S.nodeW)} class:list={['band', l.side]} fill={s.id === 'all' ? 'url(#sk-mid)' : undefined} data-s={l.source} data-t={l.target}>
              <title>{`${s.label} → ${t.label}: ${fmt(l.value)} organisations`}</title>
            </path>
          );
        })}
      </g>
      <g class="nodes">
        {S.nodes.map((n) => (
          <g class:list={['node', n.side, { quiet: n.quiet }]} data-node={n.id}>
            <rect x={n.x} y={n.y} width={S.nodeW} height={n.h} rx="2" class:list={['bar', n.side]} />
            <title>{`${n.label}: ${fmt(n.value)} organisations (${pct(n.value)})`}</title>
            {n.col === 0 && (
              <text x={n.x - 10} y={n.y + n.h / 2} text-anchor="end" class="lbl">
                <tspan class="name" dy="-0.35em">{n.label}</tspan>
                <tspan class="val" x={n.x - 10} dy="1.25em">{fmt(n.value)}</tspan>
                {n.caption && <tspan class="cap" x={n.x - 10} dy="1.3em">{n.caption.length > 40 ? `${n.caption.slice(0, 39)}…` : n.caption}</tspan>}
              </text>
            )}
            {(n.col === 1 || n.col === 2 || n.col === 3) && (
              <text x={n.x + S.nodeW / 2} y={n.y - 8} text-anchor="middle" class="lbl">
                <tspan class="name" x={n.x + S.nodeW / 2} dy="-1.2em">{n.label.length > 34 ? `${n.label.slice(0, 33)}…` : n.label}</tspan>
                <tspan class="val" x={n.x + S.nodeW / 2} dy="1.25em">{fmt(n.value)}{n.col > 1 ? ` · ${pct(n.value)}` : ''}</tspan>
              </text>
            )}
            {n.col === 4 && (
              <text x={n.x + S.nodeW + 10} y={n.y + n.h / 2} class="lbl">
                <tspan class="name" dy={n.quiet || n.caption ? '-0.3em' : '0.35em'}>{n.label.length > 44 ? `${n.label.slice(0, 43)}…` : n.label} </tspan>
                <tspan class="val">{fmt(n.value)}</tspan>
                {(n.quiet || n.caption) && <tspan class="cap" x={n.x + S.nodeW + 10} dy="1.25em">{[n.caption, n.quiet && 'Little activity'].filter(Boolean).join(' · ')}</tspan>}
              </text>
            )}
          </g>
        ))}
      </g>
    </svg>
  </div>
  <figcaption class="body-sm muted">
    Every organisation counts once: {Math.round(S.total).toLocaleString('en')} in all, {S.curatedOnly ? `${S.curatedOnly} from the curated network and the rest` : 'all'} found by the field scanner. An organisation working on several steps is split across them in proportion to how often it appears on each, so step values can be fractions. Steps under a third of the median are marked "Little activity". Hover a band for its value.
  </figcaption>
  <details class="tbl">
    <summary class="label">View as table</summary>
    <div class="cols">
      {[0, 1, 3, 4].map((c) => (
        <table>
          <thead><tr><th>{['Organisation type', 'Group', '', 'Sub-goal', 'Step'][c]}</th><th class="n">Organisations</th></tr></thead>
          <tbody>{S.nodes.filter((n) => n.col === c).map((n) => <tr><td>{n.step ? <a href={url(`/problems/${problem.slug}/map/#${n.step}`)}>{n.label}</a> : n.label}</td><td class="n data">{fmt(n.value)}</td></tr>)}</tbody>
        </table>
      ))}
    </div>
  </details>
</figure>

<script>
  for (const root of document.querySelectorAll<SVGElement>('[data-sankey] svg')) {
    const bands = [...root.querySelectorAll<SVGPathElement>('.band')];
    const nodes = [...root.querySelectorAll<SVGGElement>('.node')];
    // Hovering a node lights up every band through it, upstream and downstream.
    const trace = (id: string) => {
      const on = new Set<SVGPathElement>(), seen = new Set([id]);
      const walk = (k: string, dir: 's' | 't') => {
        for (const b of bands) if (b.dataset[dir === 't' ? 's' : 't'] === k) {
          on.add(b);
          const next = b.dataset[dir]!;
          if (!seen.has(next)) { seen.add(next); walk(next, dir); }
        }
      };
      walk(id, 't'); walk(id, 's');
      return { on, seen };
    };
    const clear = () => { root.classList.remove('focus'); bands.forEach((b) => b.classList.remove('on')); nodes.forEach((n) => n.classList.remove('on')); };
    for (const n of nodes) {
      n.addEventListener('mouseenter', () => {
        const { on, seen } = trace(n.dataset.node!);
        root.classList.add('focus');
        bands.forEach((b) => b.classList.toggle('on', on.has(b)));
        nodes.forEach((x) => x.classList.toggle('on', seen.has(x.dataset.node!)));
      });
      n.addEventListener('mouseleave', clear);
    }
    for (const b of bands) {
      b.addEventListener('mouseenter', () => { root.classList.add('focus'); b.classList.add('on'); });
      b.addEventListener('mouseleave', clear);
    }
  }
</script>

<style>
  .sk { margin: 0; display: grid; gap: var(--space-3); }
  .scroll { overflow-x: auto; background: var(--surface-1); border: var(--stroke-hairline) solid var(--line); padding: var(--space-4) 0; }
  svg { display: block; margin: 0 auto; width: 100%; max-width: 1360px; min-width: 1040px; height: auto; }
  /* DESIGN-TODO: viz-1/viz-2 dark-mode steps sit slightly above the validator's lightness band (L 0.72–0.76). */
  .band { opacity: 0.32; transition: opacity 120ms; }
  .band.who { fill: var(--viz-1); }
  .band.what { fill: var(--viz-2); }
  .focus .band { opacity: 0.12; }
  .focus .band.on { opacity: 0.55; }
  .bar.who { fill: var(--viz-1); }
  .bar.what { fill: var(--viz-2); }
  .node { cursor: default; }
  .focus .node:not(.on) .lbl { opacity: 0.4; }
  .lbl { font-family: var(--font-sans); fill: var(--ink); }
  .name { font-size: 13px; font-weight: 600; }
  .val { font-family: var(--font-mono); font-size: 12px; fill: var(--ink-muted); font-variant-numeric: tabular-nums; }
  .cap { font-size: 11px; fill: var(--ink-muted); }
  .quiet .cap { fill: var(--caution); }
  .tbl summary { cursor: pointer; }
  .cols { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: var(--space-4); margin-top: var(--space-3); }
  table { border-collapse: collapse; width: 100%; background: var(--surface-1); }
  th, td { padding: var(--space-1) var(--space-3); border-bottom: var(--stroke-hairline) solid var(--line); text-align: left; font-size: 13px; }
  th { background: var(--surface-2); font-size: 12px; font-weight: 500; }
  .n { text-align: right; }
</style>
