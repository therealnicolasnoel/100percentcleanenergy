---
/**
 * Network map: organisations around a problem, the relationships between them
 * (funds, invests in, co-authors, accelerated, parent of, partners) and the steps
 * of the tree they work on. Built from field/relations.json (the relationship scanner).
 */
import Icon from './Icon.astro';
import { layoutGraph, GROUP_LABEL, GROUP_ORDER, TYPE_LABEL, type Relations } from '../lib/relations';
import type { Field } from '../lib/field';
import type { ProblemData } from '../lib/problemData';
import type { Problem } from '../data/problems';
import { gh, url, formatDate } from '../site.config';

interface Props { rel: Relations; field: Field | null; data: ProblemData; problem: Problem }
const { rel, field, data, problem } = Astro.props;
const G = layoutGraph(rel, data);
const pos = new Map(G.nodes.map((n) => [n.id, n]));
const recById = new Map((field?.records ?? []).map((r) => [r.id, r]));
const EDGE_LABEL: Record<string, [string, string]> = {
  funds: ['funds', 'funded by'], invests_in: ['invests in', 'backed by'], accelerated: ['accelerated', 'accelerated by'],
  parent_of: ['parent of', 'part of'], partners: ['partners with', 'partners with'], coauthors: ['co-authors with', 'co-authors with'],
  supplies: ['supplies', 'supplied by'], regulates: ['regulates', 'regulated by'],
};
const EDGE_TYPES = Object.keys(EDGE_LABEL).filter((t) => rel.edges.some((e) => e.type === t));
const evidence = (ev: string) => {
  if (ev.startsWith('http')) return { title: 'Wikidata', url: ev };
  if (ev.startsWith('network:')) return { title: 'Curated network', url: url(`/problems/${problem.slug}/network/`) };
  const r = recById.get(ev);
  return r ? { title: r.title, url: r.url } : null;
};
const relsOf = (key: string) => {
  const out: { other: string; label: string; weight: number; ev: string[] }[] = [];
  for (const e of rel.edges) {
    if (e.source === key) out.push({ other: e.target, label: EDGE_LABEL[e.type]?.[0] ?? e.type, weight: e.weight, ev: e.evidence });
    else if (e.target === key) out.push({ other: e.source, label: EDGE_LABEL[e.type]?.[1] ?? e.type, weight: e.weight, ev: e.evidence });
  }
  return out.sort((a, b) => b.weight - a.weight);
};
const nameOf = (k: string) => pos.get(k)?.label ?? k;
const curatedActor = (id: string | null) => (id ? data.actors.find((a) => a.id === id) : null);
const shape = (n: (typeof G.nodes)[number]) => {
  if (n.kind === 'step') return `M${n.x - 5},${n.y - 5}h10v10h-10z`;
  if (n.group === 'capital') { const r = n.r * 1.15; return `M${n.x},${n.y - r}L${n.x + r},${n.y}L${n.x},${n.y + r}L${n.x - r},${n.y}Z`; }
  return null;
};
---
<div class="nw" data-graph>
  <div class="bar">
    <div class="legend body-sm" aria-label="Legend">
      {GROUP_ORDER.map((g) => (
        <button type="button" class="lg on" data-group-toggle={g}>
          <svg width="14" height="14" aria-hidden="true">
            {g === 'capital' ? <path d="M7,1L13,7L7,13L1,7Z" class="mk capital" /> : <circle cx="7" cy="7" r="5.5" class:list={['mk', g]} />}
          </svg>
          {GROUP_LABEL[g]}
        </button>
      ))}
      <span class="lg static"><svg width="14" height="14" aria-hidden="true"><rect x="2" y="2" width="10" height="10" class="mk step" /></svg>Sub-goal</span>
      <span class="lg static"><svg width="14" height="14" aria-hidden="true"><circle cx="7" cy="7" r="5" class="mk research" /><circle cx="7" cy="7" r="6.3" class="ring" /></svg>In the curated network</span>
    </div>
    <div class="filters body-sm" role="group" aria-label="Relationship types">
      {EDGE_TYPES.map((t) => <button type="button" class="chip on" data-edge-toggle={t}>{EDGE_LABEL[t][0]} <span class="data-sm">{rel.edges.filter((e) => e.type === t).length}</span></button>)}
      <button type="button" class="chip on" data-edge-toggle="works_on">works on step</button>
    </div>
  </div>

  <div class="frame">
    <div class="canvas">
      <svg class="graph" viewBox={`0 0 ${G.width} ${G.height}`} width={G.width} height={G.height} role="img" aria-label={`Network of ${rel.nodes.length} organisations and ${rel.edges.length} relationships`}>
        <g class="edges">
          {G.edges.map((e) => {
            const a = pos.get(e.source)!, b = pos.get(e.target)!;
            return <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} class:list={['e', e.type]} stroke-width={e.type === 'works_on' ? 1 : Math.min(3, 0.8 + Math.log2(1 + e.weight) * 0.6)} data-a={e.source} data-b={e.target} data-type={e.type} />;
          })}
        </g>
        <g class="nodes">
          {G.nodes.map((n) => {
            const d = shape(n);
            return (
              <g class:list={['n', n.kind, n.group]} data-id={n.id} data-group={n.group ?? 'step'} tabindex="0" role="button" aria-label={n.label}>
                {d ? <path d={d} class:list={['mk', n.kind === 'step' ? 'step' : n.group]} /> : <circle cx={n.x} cy={n.y} r={n.r} class:list={['mk', n.group]} />}
                {n.curated && <circle cx={n.x} cy={n.y} r={n.r + 3} class="ring" />}
                <circle cx={n.x} cy={n.y} r={Math.max(n.r + 4, 10)} class="hit" />
                {n.labelled && (
                  <text x={n.kind === 'step' ? n.x + (n.x >= G.width / 2 ? 9 : -9) : n.x} y={n.kind === 'step' ? n.y + 4 : n.y - n.r - 5}
                        text-anchor={n.kind === 'step' ? (n.x >= G.width / 2 ? 'start' : 'end') : 'middle'} class:list={['t', n.kind]}>
                    {n.label.length > 34 ? `${n.label.slice(0, 33)}…` : n.label}
                  </text>
                )}
                <title>{n.label}</title>
              </g>
            );
          })}
        </g>
      </svg>
    </div>

    <aside class="inspector" aria-live="polite">
      <section data-panel="" class="pnl">
        <p class="label muted">Network map</p>
        <h3 class="heading">{rel.nodes.length} organisations, {rel.edges.length} relationships</h3>
        <p class="body-sm muted">The curated sub-goals sit on the ring; organisations are pulled towards the steps they work on and the organisations they're linked to. Select one to see its relationships and the evidence for each.</p>
        <ul class="plain body-sm">
          {Object.entries(rel.totals.by_type).map(([t, n]) => <li><span class="data">{n}</span> {EDGE_LABEL[t]?.[0] ?? t}</li>)}
        </ul>
        <p class="body-sm muted">From the relationship scanner, {formatDate(new Date(rel.generated_at))}: funders, sponsors and co-authors named on papers, reports and grants; Y Combinator's startups; and investors, funders, parents and partners listed on Wikidata ({rel.totals.wikidata_resolved} organisations resolved, {rel.totals.from_wikidata} found only there). Machine-made: check a relationship's evidence before relying on it.</p>
      </section>
      {G.nodes.filter((n) => n.kind === 'org').map((n) => {
        const o = n.org!;
        const rels = relsOf(n.id);
        const actor = curatedActor(o.in_network);
        return (
          <section data-panel={n.id} class="pnl" hidden>
            <p class="label muted">{TYPE_LABEL[o.type] ?? o.type}{o.country && ` · ${o.country}`}{actor && ' · in the curated network'}</p>
            <h3 class="heading">{o.name}</h3>
            {actor ? <p class="body">{actor.description}</p> : o.description && <p class="body-sm muted">{o.description} (Wikidata)</p>}
            {(actor?.url ?? o.url) && <a class="body-sm" href={actor?.url ?? o.url!} target="_blank" rel="noopener">{(actor?.url ?? o.url!).replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a>}
            {Object.keys(o.steps).length > 0 && (
              <div class="sec"><p class="label muted">Works on</p>
                <ul class="plain body-sm">{Object.entries(o.steps).map(([s, w]) => <li><a href={url(`/problems/${problem.slug}/map/#${s}`)}>{data.nodes[s].title}</a> <span class="data-sm muted">{w}</span></li>)}</ul></div>
            )}
            <div class="sec"><p class="label muted">Relationships <span class="data-sm">{rels.length}</span></p>
              <ul class="plain body-sm rels">
                {rels.slice(0, 14).map((r) => {
                  const ev = r.ev.map(evidence).filter(Boolean).slice(0, 2);
                  return (
                    <li>
                      {r.label} <a href={`#${encodeURIComponent(r.other)}`} data-goto={r.other}>{nameOf(r.other)}</a>{r.weight > 1 && <span class="data-sm muted"> ×{r.weight}</span>}
                      {ev.length > 0 && <span class="ev">{ev.map((x) => <a href={x!.url ?? undefined} target="_blank" rel="noopener" class="data-sm">{x!.title.length > 60 ? `${x!.title.slice(0, 59)}…` : x!.title}</a>)}</span>}
                    </li>
                  );
                })}
              </ul>
            </div>
            {o.records > 0 && <a class="body-sm" href={url(`/problems/${problem.slug}/field/#directory`)}>Appears in {o.records} items in the state of the field</a>}
            {actor
              ? <a class="btn btn-secondary" href={gh.edit(actor.file)}><Icon name="pencil" />Edit in the curated network</a>
              : <span class="body-sm muted">Not in the curated network yet. Add it from <a href={url(`/problems/${problem.slug}/field/#organisations`)}>Organisations found</a>.</span>}
          </section>
        );
      })}
      {G.nodes.filter((n) => n.kind === 'step').map((n) => {
        const id = n.id.slice(5);
        const inSub = (s: string) => s === id || data.nodes[s]?.parent === id;
        const whoMap = new Map<string, number>();
        for (const e of rel.step_edges) if (inSub(e.step)) whoMap.set(e.source, (whoMap.get(e.source) ?? 0) + e.weight);
        const who = [...whoMap].map(([source, weight]) => ({ source, weight })).sort((a, b) => b.weight - a.weight);
        return (
          <section data-panel={n.id} class="pnl" hidden>
            <p class="label muted">Sub-goal{data.nodes[id].blocker && ' · main blocker'}</p>
            <h3 class="heading">{n.label}</h3>
            <div class="sec"><p class="label muted">Organisations on the map working on it <span class="data-sm">{who.length}</span></p>
              <ul class="plain body-sm">{who.slice(0, 20).map((e) => <li><a href={`#${encodeURIComponent(e.source)}`} data-goto={e.source}>{nameOf(e.source)}</a> <span class="data-sm muted">{e.weight}</span></li>)}</ul></div>
            <a class="btn btn-secondary" href={url(`/problems/${problem.slug}/map/#${id}`)}>Open in the tree map</a>
          </section>
        );
      })}
    </aside>
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-graph]')) {
    const svg = root.querySelector<SVGSVGElement>('svg.graph')!;
    const edges = [...svg.querySelectorAll<SVGLineElement>('line.e')];
    const nodes = [...svg.querySelectorAll<SVGGElement>('g.n')];
    const hiddenGroups = new Set<string>(), hiddenEdges = new Set<string>();
    let selected = '';
    const render = () => {
      const near = new Set<string>();
      for (const e of edges) {
        const vis = !hiddenEdges.has(e.dataset.type!) && !hiddenGroups.has(groupOf(e.dataset.a!)) && !hiddenGroups.has(groupOf(e.dataset.b!));
        const hit = !!selected && vis && (e.dataset.a === selected || e.dataset.b === selected);
        e.classList.toggle('off', !vis);
        e.classList.toggle('on', hit);
        if (hit) { near.add(e.dataset.a!); near.add(e.dataset.b!); }
      }
      svg.classList.toggle('focus', !!selected);
      for (const n of nodes) {
        n.classList.toggle('off', hiddenGroups.has(n.dataset.group!));
        n.classList.toggle('sel', n.dataset.id === selected);
        n.classList.toggle('near', near.has(n.dataset.id!));
      }
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== selected));
    };
    const groupMap = new Map(nodes.map((n) => [n.dataset.id!, n.dataset.group!]));
    const groupOf = (id: string) => groupMap.get(id) ?? 'step';
    const select = (id: string) => {
      selected = selected === id ? '' : id;
      render();
      history.replaceState(null, '', selected ? `#${encodeURIComponent(selected)}` : location.pathname + (location.search || ''));
    };
    root.addEventListener('click', (ev) => {
      const t = ev.target as Element;
      const g = t.closest<HTMLElement>('[data-group-toggle]');
      if (g) { const k = g.dataset.groupToggle!; hiddenGroups.has(k) ? hiddenGroups.delete(k) : hiddenGroups.add(k); g.classList.toggle('on', !hiddenGroups.has(k)); render(); return; }
      const et = t.closest<HTMLElement>('[data-edge-toggle]');
      if (et) { const k = et.dataset.edgeToggle!; hiddenEdges.has(k) ? hiddenEdges.delete(k) : hiddenEdges.add(k); et.classList.toggle('on', !hiddenEdges.has(k)); render(); return; }
      const go = t.closest<HTMLElement>('[data-goto]');
      if (go) { ev.preventDefault(); selected = ''; select(go.dataset.goto!); return; }
      const n = t.closest<SVGGElement>('g.n');
      if (n) select(n.dataset.id!);
    });
    root.addEventListener('keydown', (ev) => {
      const n = (ev.target as Element).closest?.<SVGGElement>('g.n');
      if (n && (ev.key === 'Enter' || ev.key === ' ')) { ev.preventDefault(); select(n.dataset.id!); }
    });
    const h = decodeURIComponent(location.hash.slice(1));
    if (h && nodes.some((n) => n.dataset.id === h)) select(h); else render();
    root.addEventListener('show', () => render());
  }
</script>

<style>
  .nw { display: grid; gap: var(--space-3); }
  .bar { display: grid; gap: var(--space-2); }
  .legend, .filters { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; }
  .lg { display: inline-flex; align-items: center; gap: var(--space-1); font: inherit; font-size: 13px; color: var(--ink); background: none; border: var(--stroke-hairline) solid transparent; border-radius: var(--radius-sm); padding: var(--space-1) var(--space-2); }
  button.lg { cursor: pointer; border-color: var(--line-strong); }
  button.lg:not(.on) { opacity: 0.45; text-decoration: line-through; }
  .chip { font: inherit; font-size: 13px; color: var(--ink); background: var(--surface-1); border: var(--stroke-hairline) solid var(--line-strong); border-radius: var(--radius-sm); padding: var(--space-1) var(--space-3); cursor: pointer; }
  .chip.on { background: var(--signal-tint); border-color: var(--signal); }
  .frame { display: grid; grid-template-columns: minmax(0, 1fr) 340px; border: var(--stroke-hairline) solid var(--line); background: var(--surface-0); }
  .canvas { overflow: auto; max-height: 86vh; }
  svg { display: block; }
  /* Categorical: research viz-1, building viz-2 (validated pair). Capital is ink with a diamond shape, policy a hollow circle. */
  .mk.research { fill: var(--viz-1); }
  .mk.building { fill: var(--viz-2); }
  .mk.capital { fill: var(--ink); }
  .mk.policy { fill: var(--surface-1); stroke: var(--line-strong); stroke-width: 1.5; }
  .mk.step { fill: var(--surface-2); stroke: var(--ink); stroke-width: 1.5; }
  .mk { stroke: var(--surface-1); stroke-width: 1.5; }
  .ring { fill: none; stroke: var(--ink); stroke-width: 1.5; }
  .hit { fill: transparent; }
  .n { cursor: pointer; outline: none; }
  .n:focus-visible .mk { stroke: var(--focus); stroke-width: 2.5; }
  .t { font-family: var(--font-sans); font-size: 11px; fill: var(--ink); paint-order: stroke; stroke: var(--surface-0); stroke-width: 3px; stroke-linejoin: round; pointer-events: none; }
  .t.step { font-weight: 600; font-size: 12px; }
  .e { stroke: var(--line-strong); opacity: 0.45; }
  .e.works_on { stroke: var(--line); opacity: 0.8; stroke-dasharray: 2 3; }
  .e.invests_in, .e.accelerated { stroke: var(--ink); opacity: 0.7; }
  .e.coauthors { stroke-dasharray: 4 3; }
  .e.parent_of { stroke-dasharray: 1 3; stroke-linecap: round; }
  .e.off, .n.off { display: none; }
  .focus .e { opacity: 0.08; }
  .focus .e.on { stroke: var(--signal); opacity: 1; }
  .focus .n { opacity: 0.25; }
  .focus .n.near, .focus .n.sel { opacity: 1; }
  .n.sel .mk { stroke: var(--signal); stroke-width: 3; }
  .inspector { background: var(--surface-1); border-left: var(--stroke-hairline) solid var(--line); padding: var(--space-4); overflow: auto; max-height: 86vh; }
  .pnl { display: grid; gap: var(--space-3); justify-items: start; }
  .sec { display: grid; gap: var(--space-2); width: 100%; }
  .plain { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-1); }
  .rels li { display: grid; gap: 2px; }
  .ev { display: grid; gap: 2px; padding-left: var(--space-3); border-left: var(--stroke-hairline) solid var(--line); }
  .ev a { color: var(--ink-muted); }
  @media (max-width: 900px) {
    .frame { grid-template-columns: 1fr; }
    .canvas { max-height: 70vh; }
    .inspector { border-left: 0; border-top: var(--stroke-hairline) solid var(--line); max-height: none; }
  }
</style>
