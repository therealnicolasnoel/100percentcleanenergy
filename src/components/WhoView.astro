---
/**
 * "Who's working on it": a toggle between the Sankey breakdown and the
 * network map, followed by the curated organisations.
 */
import Icon from './Icon.astro';
import SankeyBreakdown from './SankeyBreakdown.astro';
import OrgNetwork from './OrgNetwork.astro';
import ReviewBadge from './ReviewBadge.astro';
import { getField } from '../lib/field';
import { getRelations } from '../lib/relations';
import { KIND_LABEL, type ProblemData } from '../lib/problemData';
import type { Problem } from '../data/problems';
import { gh, url } from '../site.config';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

interface Props { data: ProblemData; problem: Problem }
const { data, problem } = Astro.props;
const field = getField(problem.slug);
const rel = getRelations(problem.slug);
const orgTemplate = readFileSync(join(process.cwd(), 'templates', 'organisation.json'), 'utf8');
const uncovered = data.order.filter((id) => data.nodes[id].type === 'subgoal' && !data.actorsOn[id]?.length);
---
<div class="who" data-who>
  <div class="bar">
    <div class="seg" role="tablist" aria-label="View">
      <button type="button" role="tab" class="on" aria-selected="true" data-view="breakdown">Breakdown</button>
      <button type="button" role="tab" aria-selected="false" data-view="network" disabled={!rel}>Network map</button>
    </div>
    <div class="meta">
      <ReviewBadge status={data.meta.review.network} />
      <a class="btn btn-primary" href={gh.newFile(`problems/${problem.slug}/network/your_org_id.json`, orgTemplate)}><Icon name="plus" />Add an organisation</a>
    </div>
  </div>

  <section data-pane="breakdown">
    <SankeyBreakdown field={field} data={data} problem={problem} />
  </section>
  <section data-pane="network" hidden>
    {rel ? <OrgNetwork rel={rel} field={field} data={data} problem={problem} /> : (
      <p class="body-sm muted">No relationship scan yet. Run <code class="data-sm">npm run scan:network -- {problem.slug}</code>.</p>
    )}
  </section>

  <section class="cur">
    <div class="cur-head">
      <h2 class="heading">Curated network <span class="data-sm muted">{data.actors.length}</span></h2>
      <p class="body-sm muted">Organisations people have added and checked, one file each in <code class="data-sm">problems/{problem.slug}/network/</code>. The views above add everything the field and relationship scanners found.</p>
    </div>
    <div class="scroll">
      <table>
        <thead><tr><th>Organisation</th><th>Kind</th><th>Country</th><th>Works on</th><th></th></tr></thead>
        <tbody>
          {data.actors.map((a) => (
            <tr>
              <td>{a.url ? <a href={a.url} target="_blank" rel="noopener">{a.name}</a> : a.name}<div class="body-sm muted">{a.description}</div></td>
              <td class="label">{KIND_LABEL[a.kind]}</td>
              <td class="body-sm muted">{a.country}</td>
              <td class="body-sm">{a.works_on.map((n, i) => <>{i > 0 && '; '}<a href={url(`/problems/${problem.slug}/map/#${n}`)}>{data.nodes[n].title}</a></>)}</td>
              <td><a class="body-sm" href={gh.edit(a.file)}>Edit</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {uncovered.length > 0 && (
      <p class="body-sm muted">Sub-goals with nobody in the curated network: {uncovered.map((id, i) => <>{i > 0 && ', '}<a href={url(`/problems/${problem.slug}/map/#${id}`)}>{data.nodes[id].title}</a></>)}. Adding who works on them is a useful first contribution.</p>
    )}
  </section>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-who]')) {
    const show = (view: string, push = true) => {
      root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => { const on = b.dataset.view === view; b.classList.toggle('on', on); b.setAttribute('aria-selected', String(on)); });
      root.querySelectorAll<HTMLElement>('[data-pane]').forEach((p) => (p.hidden = p.dataset.pane !== view));
      if (push) { const u = new URL(location.href); view === 'breakdown' ? u.searchParams.delete('view') : u.searchParams.set('view', view); if (view === 'breakdown') u.hash = ''; history.replaceState(null, '', u); }
    };
    root.addEventListener('click', (ev) => {
      const b = (ev.target as Element).closest<HTMLButtonElement>('[data-view]');
      if (b && !b.disabled) show(b.dataset.view!);
    });
    const q = new URLSearchParams(location.search).get('view');
    // A link to an organisation (#key) opens the network map.
    show(q === 'network' || (location.hash.length > 1 && !q) ? 'network' : 'breakdown', false);
  }
</script>

<style>
  .who { display: grid; gap: var(--space-6); margin-top: var(--space-6); }
  .bar { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-3); align-items: center; }
  .seg { display: inline-flex; border: var(--stroke-hairline) solid var(--line-strong); border-radius: var(--radius-sm); overflow: hidden; }
  .seg button { font: inherit; font-size: 14px; font-weight: 500; color: var(--ink); background: var(--surface-1); border: 0; padding: var(--space-2) var(--space-4); cursor: pointer; }
  .seg button + button { border-left: var(--stroke-hairline) solid var(--line-strong); }
  .seg button.on { background: var(--ink); color: var(--surface-0); }
  .seg button:disabled { opacity: 0.4; cursor: default; }
  .meta { display: flex; gap: var(--space-3); align-items: center; flex-wrap: wrap; }
  .cur { display: grid; gap: var(--space-3); }
  .cur-head { display: grid; gap: var(--space-1); }
  .scroll { overflow-x: auto; border: var(--stroke-hairline) solid var(--line); background: var(--surface-1); }
  table { border-collapse: collapse; width: 100%; }
  th { background: var(--surface-2); text-align: left; font-size: 12px; line-height: 16px; font-weight: 500; }
  th, td { padding: var(--space-2) var(--space-3); border-bottom: var(--stroke-hairline) solid var(--line); vertical-align: top; }
  code { background: var(--surface-2); padding: 0 var(--space-1); border-radius: var(--radius-sm); }
</style>
