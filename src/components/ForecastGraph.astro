---
/**
 * Git-style forecast: strategies as branches off `main`, with commits for the
 * projects to start, the year each sub-goal is likely done, and when the goal is
 * reached. Computed at build time (src/lib/forecast.ts).
 */
import Icon from './Icon.astro';
import { buildModel } from '../lib/simulate';
import { buildForecast, type Branch, type Commit, type Forecast } from '../lib/forecast';
import type { ProblemData } from '../lib/problemData';
import type { Problem } from '../data/problems';
import { url } from '../site.config';

interface Props { data: ProblemData; problem: Problem; target?: number; forecast?: Forecast }
const { data, problem, target = 2050, forecast } = Astro.props;
const F = forecast ?? buildForecast(buildModel(data), data, { target });
const title = (id: string) => data.nodes[id]?.title ?? id;
const pct = (x: number) => `${Math.round(x * 100)}%`;
const yr = (y: number) => (Number.isFinite(y) && y < F.start + 75 ? String(Math.round(y)) : `after ${F.start + 75}`);
const sign = (d: number) => (d >= 0.05 ? `+${d.toFixed(1)}` : d <= -0.05 ? `−${Math.abs(d).toFixed(1)}` : '±0');

// The site's "open a project" form, prefilled for a start commit.
const createUrl = (subgoal: string, step?: string, title?: string) =>
  url(`/problems/${problem.slug}/projects/new/?${new URLSearchParams({ subgoal, ...(step ? { step } : {}), ...(title ? { title } : {}) })}`);

// Geometry.
const W = 1160, LABEL = 200, RIGHT = 150, TOP = 44, LANE = 60;
const y0 = F.start, y1 = F.start + 50, NOW = 4;
// Piecewise time axis: the first NOW years ("next steps", where projects start) get a
// wide zone so commits don't pile up; the decades after are linear.
const PLOT = W - LABEL - RIGHT - 16, ZONE = PLOT * 0.24;
const X = (y: number) => {
  const t = Math.min(y1, Math.max(y0, y)) - y0;
  return LABEL + 16 + (t < NOW ? (t / NOW) * ZONE : ZONE + ((t - NOW) / (y1 - y0 - NOW)) * (PLOT - ZONE));
};
const laneY = (i: number) => TOP + i * LANE;
// The four lines that matter first: today, the best path, the strongest single focus,
// and the risk of stalling. The others sit below "Show all strategies".
const byKind = (k: Branch['kind']) => F.branches.filter((b) => b.kind === k);
const topFocus = [...byKind('focus')].sort((a, b) => b.p - a.p)[0];
const core = [byKind('main')[0], byKind('best')[0], topFocus, byKind('risk')[0]].filter(Boolean);
const ordered = [...core, ...F.branches.filter((b) => !core.includes(b)).sort((a, b) => b.p - a.p)];
const CORE = core.length;
const H = TOP + ordered.length * LANE + 10;
const HCORE = TOP + CORE * LANE + 10;
const human = (b: Branch) => b.kind === 'main' ? "Today's projects" : b.kind === 'best' ? 'Best path' : b.kind === 'risk' ? 'If projects stall' : b.kind === 'balanced' ? 'Spread evenly' : `Focus: ${title(b.id.replace('focus/', ''))}`;
const pathOf = (b: Branch, i: number) => {
  const y = laneY(i), goal = b.commits.find((c) => c.kind === 'goal')!;
  const end = X(Math.min(goal.year, y1));
  if (i === 0) return `M${X(y0)},${y} L${end},${y}`;
  const m = laneY(0);
  return `M${X(y0)},${m} C${X(y0 + 1.4)},${m} ${X(y0 + 0.4)},${y} ${X(y0 + 1.8)},${y} L${end},${y}`;
};
const dot = (c: Commit, y: number) => {
  const x = X(Math.min(c.year, y1));
  if (c.kind === 'goal') return `M${x},${y - 8}L${x + 8},${y}L${x},${y + 8}L${x - 8},${y}Z`;
  return null;
};
---
<section class="fc" data-forecast>
  <div class="graph-wrap">
    <svg class="git collapsed" viewBox={`0 0 ${W} ${HCORE}`} data-h-core={HCORE} data-h-all={H} data-w={W} role="img" aria-label={`Forecast branches for ${problem.title}`}>
      <rect x={X(y0)} y={TOP - 26} width={X(y0 + NOW) - X(y0)} height={H - TOP + 20} class="now" />
      <text x={(X(y0) + X(y0 + NOW)) / 2} y={TOP - 30} text-anchor="middle" class="tick strong">next steps ({y0}–{y0 + NOW})</text>
      {Array.from({ length: 5 }, (_, k) => Math.ceil((y0 + NOW + 1) / 10) * 10 + k * 10).filter((y) => y <= y1).map((y) => (
        <>
          <line x1={X(y)} x2={X(y)} y1={TOP - 26} y2={H - 6} class="grid" />
          <text x={X(y)} y={TOP - 30} text-anchor="middle" class="tick">{y}</text>
        </>
      ))}
      <line x1={X(target)} x2={X(target)} y1={TOP - 26} y2={H - 6} class="target" />
      <text x={X(target) + 4} y={TOP - 14} class="tick strong">{target}</text>
      {ordered.map((b, i) => {
        const y = laneY(i);
        const goal = b.commits.find((c) => c.kind === 'goal')!;
        return (
          <g class:list={['lane', b.kind, { sel: b.kind === 'best', extra: i >= CORE }]} data-branch={b.id} tabindex="0" role="button" aria-label={`${b.name}: ${pct(b.p)} by ${target}`}>
            <rect x="0" y={y - LANE / 2} width={W} height={LANE} class="hit" />
            <text x="12" y={y - 2} class="hn">{human(b).length > 26 ? `${human(b).slice(0, 25)}…` : human(b)}</text>
            <text x="12" y={y + 13} class="sum">{b.name}</text>
            <path d={pathOf(b, i)} class="br" />
            {goal.year >= y1 && <line x1={X(y1)} x2={W - RIGHT + 6} y1={y} y2={y} class="br open" />}
            {b.commits.filter((c) => c.kind !== 'fork').map((c) => {
              const x = X(Math.min(c.year, y1));
              const d = dot(c, y);
              return d
                ? <path d={d} class="c goal"><title>{`${c.hash} ${c.message}`}</title></path>
                : <circle cx={x} cy={y} r={c.kind === 'milestone' ? 4.5 : 5.5} class:list={['c', c.kind, { bn: c.bottleneck }]}><title>{`${c.hash} ${yr(c.year)} ${c.message}`}</title></circle>;
            })}
            <text x={W - RIGHT + 14} y={y - 2} class="pv">{pct(b.p)} by {target}</text>
            <text x={W - RIGHT + 14} y={y + 13} class="dv">{b.kind === 'main' ? `median ${yr(b.median)}` : `${sign(b.delta)} pts · ${yr(b.median)}`}</text>
          </g>
        );
      })}
    </svg>
  </div>
  <p class="legend body-sm muted">
    <span><svg width="12" height="12" aria-hidden="true"><circle cx="6" cy="6" r="5" class="lg start" /></svg>start projects</span>
    <span><svg width="12" height="12" aria-hidden="true"><circle cx="6" cy="6" r="5" class="lg keep" /></svg>keep a project going</span>
    <span><svg width="12" height="12" aria-hidden="true"><circle cx="6" cy="6" r="4" class="lg ms" /></svg>sub-goal done (median)</span>
    <span><svg width="12" height="12" aria-hidden="true"><circle cx="6" cy="6" r="4" class="lg bn" /></svg>last sub-goal: the bottleneck</span>
    <span><svg width="14" height="14" aria-hidden="true"><path d="M7,0L14,7L7,14L0,7Z" class="lg goal" /></svg>goal reached in half of futures</span>
  </p>
  {ordered.length > CORE && <button type="button" class="btn btn-secondary all" data-all>Show all {ordered.length} strategies</button>}

  <div class="log-wrap">
    {ordered.map((b) => (
      <section class="log" data-log={b.id} hidden={b.kind !== 'best'}>
        <div class="log-head">
          <p class="name-big">{human(b)} <span class="mono data-sm muted">{b.name}</span></p>
          <p class="body">{b.summary}</p>
          <dl class="stats">
            <div><dt class="label muted">By {target}</dt><dd class="numeral">{pct(b.p)}</dd></div>
            <div><dt class="label muted">vs main</dt><dd class="numeral">{b.kind === 'main' ? '—' : `${sign(b.delta)} pts`}</dd></div>
            <div><dt class="label muted">Half of futures by</dt><dd class="numeral">{yr(b.median)}</dd></div>
            <div><dt class="label muted">Bottleneck</dt><dd class="body-sm">{b.bottleneck ? title(b.bottleneck) : '—'}</dd></div>
          </dl>
        </div>
        <ol class="commits">
          {b.commits.map((c) => (
            <li class:list={['cm', c.kind]}>
              <span class="hash data-sm">{c.hash}</span>
              <span class="when data-sm muted">{c.kind === 'fork' || c.kind === 'start' || c.kind === 'keep' || c.kind === 'risk' ? 'now' : yr(c.year)}</span>
              <span class="msg body-sm">
                {c.message}
                {c.kind === 'start' && c.subgoal && <a class="mk" href={createUrl(c.subgoal, c.step)}><Icon name="plus" size={12} />Open a project here</a>}
                {(c.kind === 'milestone' && c.subgoal) && <a class="mk muted" href={url(`/problems/${problem.slug}/map/#${c.subgoal}`)}>Open in the tree</a>}
              </span>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>

  <details class="how body-sm muted">
    <summary>How the forecast works</summary>
    <p>An illustrative model, not a prediction. Every line runs the same {F.runs.toLocaleString('en')} simulated futures, so differences come from the strategy alone. The best path adds {F.budget} new projects two at a time, each pair on whichever step raises the chance by {target} most. New projects count as active, average-sized projects that deliver 45% of the time. It all rests on the sub-goal estimates in the Plan, which people own and can change.</p>
  </details>
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-forecast]')) {
    const select = (id: string) => {
      root.querySelectorAll<SVGGElement>('g.lane').forEach((g) => g.classList.toggle('sel', g.dataset.branch === id));
      root.querySelectorAll<HTMLElement>('[data-log]').forEach((l) => (l.hidden = l.dataset.log !== id));
    };
    root.addEventListener('click', (ev) => {
      const g = (ev.target as Element).closest<SVGGElement>('g.lane');
      if (g) select(g.dataset.branch!);
    });
    const svg = root.querySelector<SVGSVGElement>('svg.git')!;
    root.querySelector<HTMLButtonElement>('[data-all]')?.addEventListener('click', (ev) => {
      const btn = ev.currentTarget as HTMLButtonElement;
      const open = svg.classList.toggle('collapsed') === false;
      svg.setAttribute('viewBox', `0 0 ${svg.dataset.w} ${open ? svg.dataset.hAll : svg.dataset.hCore}`);
      btn.textContent = open ? 'Show fewer' : `Show all ${root.querySelectorAll('g.lane').length} strategies`;
    });
    root.addEventListener('keydown', (ev) => {
      const g = (ev.target as Element).closest?.<SVGGElement>('g.lane');
      if (g && (ev.key === 'Enter' || ev.key === ' ')) { ev.preventDefault(); select(g.dataset.branch!); }
    });
  }
</script>

<style>
  .fc { display: grid; gap: var(--space-4); }
  .fc > * { min-width: 0; }
  .mono, .name { font-family: var(--font-mono); }
  .mk { margin-left: var(--space-2); white-space: nowrap; display: inline-flex; gap: 2px; align-items: center; }
  .graph-wrap { overflow-x: auto; background: var(--surface-1); border: var(--stroke-hairline) solid var(--line); }
  .git { display: block; width: 100%; min-width: 900px; height: auto; }
  .now { fill: var(--surface-0); }
  .grid { stroke: var(--line); stroke-width: 1; }
  .target { stroke: var(--ink); stroke-width: 1; stroke-dasharray: 2 3; }
  .tick { font-family: var(--font-mono); font-size: 11px; fill: var(--ink-muted); }
  .tick.strong { fill: var(--ink); }
  .lane { cursor: pointer; outline: none; }
  .hit { fill: transparent; }
  .lane:hover .hit { fill: var(--surface-2); }
  .lane:focus-visible .hit { stroke: var(--focus); stroke-width: 2; }
  .lane.sel .hit { fill: var(--signal-tint); }
  .name { font-size: 13px; font-weight: 500; fill: var(--ink); }
  .sum { font-family: var(--font-sans); font-size: 11px; fill: var(--ink-muted); }
  .br { fill: none; stroke: var(--line-strong); stroke-width: 2; }
  .lane.main .br { stroke: var(--ink); stroke-width: 3; }
  .lane.sel .br { stroke: var(--signal); stroke-width: 3; }
  .br.open { stroke-dasharray: 3 4; }
  .c { stroke: var(--surface-1); stroke-width: 2; }
  .c.start, .c.risk { fill: var(--ink); }
  .c.keep { fill: var(--surface-1); stroke: var(--ink); stroke-width: 2; }
  .c.fork { fill: var(--line-strong); }
  .c.milestone { fill: var(--surface-1); stroke: var(--ink-muted); stroke-width: 1.5; }
  .c.milestone.bn { fill: var(--ink); stroke: var(--ink); }
  .c.goal { fill: var(--ink); stroke: var(--surface-1); }
  .lane.sel .c.start, .lane.sel .c.goal, .lane.sel .c.milestone.bn { fill: var(--signal); stroke: var(--surface-1); }
  .pv { font-family: var(--font-mono); font-size: 13px; font-weight: 500; fill: var(--ink); }
  .dv { font-family: var(--font-mono); font-size: 11px; fill: var(--ink-muted); }
  .legend { display: flex; flex-wrap: wrap; gap: var(--space-4); }
  .legend span { display: inline-flex; gap: var(--space-1); align-items: center; }
  .lg.start { fill: var(--ink); }
  .lg.keep { fill: var(--surface-1); stroke: var(--ink); stroke-width: 2; }
  .lg.ms { fill: var(--surface-1); stroke: var(--ink-muted); stroke-width: 1.5; }
  .lg.bn, .lg.goal { fill: var(--ink); }
  .log { background: var(--surface-1); border: var(--stroke-hairline) solid var(--line); border-radius: var(--radius-md); padding: var(--space-4); display: grid; gap: var(--space-4); }
  .log-head { display: grid; gap: var(--space-2); }
  .name-big { font-size: 16px; font-weight: 600; }
  .stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-4); margin: 0; }
  @media (max-width: 720px) { .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .stats div { display: grid; gap: 2px; }
  .stats dd { margin: 0; }
  .numeral { font-family: var(--font-mono); font-size: 20px; line-height: 26px; font-weight: 500; }
  .commits { list-style: none; margin: 0; padding: 0; border-left: var(--stroke-path) solid var(--line-strong); }
  .cm { display: grid; grid-template-columns: 70px 72px minmax(0, 1fr); gap: var(--space-3); align-items: baseline; padding: var(--space-2) var(--space-3); position: relative; }
  .cm::before { content: ''; position: absolute; left: -6px; top: 13px; width: 10px; height: 10px; border-radius: 50%; background: var(--surface-1); border: var(--stroke-path) solid var(--ink-muted); }
  .cm.start::before, .cm.goal::before { background: var(--ink); border-color: var(--ink); }
  .cm.goal::before { border-radius: 2px; transform: rotate(45deg); }
  .cm.start { background: var(--surface-0); }
  .hash { color: var(--ink-muted); }
  .how summary { cursor: pointer; }
  .how p { margin-top: var(--space-2); max-width: 80ch; }
  .all { justify-self: start; }
  .collapsed .extra { visibility: hidden; }
  .hn { font-family: var(--font-sans); font-size: 13px; font-weight: 600; fill: var(--ink); }
  .scroll { overflow-x: auto; margin-top: var(--space-2); }
  table { border-collapse: collapse; width: 100%; background: var(--surface-1); }
  th, td { padding: var(--space-2) var(--space-3); border-bottom: var(--stroke-hairline) solid var(--line); text-align: left; }
  th { background: var(--surface-2); font-size: 12px; font-weight: 500; }
  .n { text-align: right; }
</style>
