---
import Icon from './Icon.astro';
interface Props { status: 'draft' | 'generated' | 'reviewed' | 'challenged'; reviewers?: string[] }
const { status, reviewers = [] } = Astro.props;
const map = {
  draft: { icon: 'pencil', text: 'Draft', cls: 'neutral' },
  generated: { icon: 'dotted', text: 'AI-generated, unreviewed', cls: 'neutral' },
  reviewed: { icon: 'check', text: reviewers.length ? `Reviewed · ${reviewers.join(', ')}` : 'Reviewed', cls: 'positive' },
  challenged: { icon: 'flag', text: 'Challenged', cls: 'caution' },
} as const;
const b = map[status];
---
<span class:list={['badge label', b.cls]}><Icon name={b.icon} size={12} />{b.text}</span>
<style>
  .badge { display: inline-flex; align-items: center; gap: var(--space-1); padding: var(--space-1) var(--space-2); border-radius: var(--radius-sm); white-space: nowrap; }
  .neutral { color: var(--ink-muted); background: var(--surface-2); }
  .positive { color: var(--positive); background: var(--positive-tint); }
  .caution { color: var(--caution); background: var(--caution-tint); }
</style>
