---
/**
 * Universal tree map. Lays out any problem's AND/OR step tree left to right,
 * with an inspector for the selected step. Layout is computed at build time;
 * the only client code toggles which step is selected.
 */
import ReviewBadge from './ReviewBadge.astro';
import SourceChip from './SourceChip.astro';
import Icon from './Icon.astro';
import { layoutTree, TREE, STATUS_LABEL, KIND_LABEL, type ProblemData } from '../lib/problemData';
import { problems, type Problem } from '../data/problems';
import { gh, url } from '../site.config';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

interface Props { data: ProblemData; problem: Problem }
const { data, problem } = Astro.props;
const L = layoutTree(data);
const nodeTemplate = readFileSync(join(process.cwd(), 'templates', 'node.json'), 'utf8');
const parentsJson = JSON.stringify(data.parents);

const edgePath = (from: string, to: string) => {
  const a = L.pos[from], b = L.pos[to];
  const x1 = a.x + TREE.cardW, y1 = a.y + TREE.cardH / 2, x2 = b.x, y2 = b.y + TREE.cardH / 2, mx = (x1 + x2) / 2;
  return `M${x1} ${y1} C${mx} ${y1} ${mx} ${y2} ${x2} ${y2}`;
};
const typeLabel = { goal: 'Goal', subgoal: 'Sub-goal', action: 'Step' };
const unsupported = data.order.filter((id) => !data.nodes[id].sources.length).length;
---
<div class="tm" data-tree data-root={data.root} data-parents={parentsJson}>
  <div class="bar">
    <div class="legend body-sm muted">
      <span><svg width="28" height="8" aria-hidden="true"><line x1="0" y1="4" x2="28" y2="4" stroke="var(--line-strong)" /></svg> AND: all needed</span>
      <span><svg width="28" height="8" aria-hidden="true"><line x1="0" y1="4" x2="28" y2="4" stroke="var(--line-strong)" stroke-dasharray="4 4" /></svg> OR: any one is enough</span>
      <span><svg width="28" height="8" aria-hidden="true"><line x1="0" y1="4" x2="28" y2="4" stroke="var(--signal)" stroke-width="2" /></svg> Path to the selected step</span>
    </div>
    <div class="meta">
      <ReviewBadge status={data.meta.review.map} />
      <span class="data-sm muted">{data.order.length} steps · {unsupported} without a source</span>
    </div>
  </div>

  <div class="frame">
    <div class="canvas" tabindex="-1">
      <div class="graph" style={`width:${L.width}px;height:${L.height}px`}>
        <svg width={L.width} height={L.height} aria-hidden="true">
          {L.edges.map((e) => (
            <path d={edgePath(e.from, e.to)} data-edge={`${e.from}>${e.to}`} class="edge" stroke-dasharray={e.or ? '4 4' : undefined} />
          ))}
          {L.edges.filter((e) => e.or && e.first).map((e) => (
            <text x={L.pos[e.from].x + TREE.cardW + 8} y={L.pos[e.from].y + TREE.cardH / 2 - 6} class="data-sm or">any one</text>
          ))}
        </svg>
        {data.order.map((id) => {
          const n = data.nodes[id], p = L.pos[id];
          return (
            <button type="button" class:list={['card', n.type, n.status]} data-node={id} style={`left:${p.x}px;top:${p.y}px;width:${TREE.cardW}px;height:${TREE.cardH}px`} aria-label={n.title}>
              <span class="k data-sm">{typeLabel[n.type]}{n.children.length > 0 && ` · ${n.logic}`}{n.blocker && <span class="blk"> · main blocker</span>}</span>
              <span class="t">{n.title}</span>
              <span class="s data-sm">{STATUS_LABEL[n.status]}{(data.actorsOn[id]?.length ?? 0) > 0 && ` · ${data.actorsOn[id].length} orgs`}</span>
            </button>
          );
        })}
      </div>
    </div>

    <aside class="inspector" aria-live="polite">
      {data.order.map((id) => {
        const n = data.nodes[id];
        const who = (data.actorsOn[id] ?? []).map((a) => data.actorsById[a]);
        const childTemplate = nodeTemplate;
        const shared = n.shared_with.map((num) => problems.find((p) => p.number === num)!).filter(Boolean);
        return (
          <section class="panel-n" data-panel={id} hidden={id !== data.root}>
            <p class="label muted">{typeLabel[n.type]}{n.children.length > 0 && ` · ${n.logic === 'AND' ? 'needs all of its parts' : 'any one part is enough'}`}</p>
            <h2 class="heading">{n.title}</h2>
            <div class="row">
              <span class:list={['st label', n.status]}>{STATUS_LABEL[n.status]}</span>
              {n.blocker && <span class="label tag strong">Main blocker</span>}
            </div>
            {n.description && <p class="body">{n.description}</p>}
            {n.bottlenecks.length > 0 && (
              <div class="sec"><p class="label muted">Bottlenecks</p><div class="row">{n.bottlenecks.map((b) => <span class="label tag">{b}</span>)}</div></div>
            )}
            <div class="sec">
              <p class="label muted">Evidence</p>
              {n.sources.length
                ? <div class="row">{n.sources.map((s) => <SourceChip {...s} />)}</div>
                : <span class="unsupported label"><Icon name="flag" size={12} />Unsupported: no source yet</span>}
            </div>
            {n.estimate && (
              <div class="sec"><p class="label muted">Estimate</p><p class="data">{n.estimate.p10}–{n.estimate.p90} years (P10–P90) · P(success) {n.estimate.p_success}</p></div>
            )}
            {n.children.length > 0 && (
              <div class="sec"><p class="label muted">Parts</p>
                <ul class="plain body-sm">{n.children.map((c) => <li><a href={`#${c}`} data-goto={c}>{data.nodes[c].title}</a></li>)}</ul></div>
            )}
            <div class="sec">
              <p class="label muted">Who's working on this <span class="data-sm">{who.length}</span></p>
              {who.length
                ? <ul class="plain body-sm">{who.map((a) => <li><a href={url(`/problems/${problem.slug}/network/#${a.id}`)}>{a.name}</a> <span class="muted">· {KIND_LABEL[a.kind]}</span></li>)}</ul>
                : <p class="body-sm muted">Nobody listed yet. That can mean a neglected step, or one we haven't mapped.</p>}
            </div>
            {shared.length > 0 && (
              <div class="sec"><p class="label muted">Shared with</p>
                <ul class="plain body-sm">{shared.map((p) => <li><span class="data-sm">{p.number}</span> {p.active ? <a href={url(`/problems/${p.slug}/map/`)}>{p.title}</a> : p.title}</li>)}</ul></div>
            )}
            <div class="sec gh">
              <p class="label muted">On GitHub</p>
              <a class="btn btn-secondary" href={gh.edit(n.file)}><Icon name="pencil" />Propose an edit</a>
              <a class="btn btn-ghost" href={gh.newFile(`problems/${problem.slug}/map/nodes/your_step_id.json`, childTemplate)}><Icon name="plus" />Add a step under this</a>
              <a class="btn btn-ghost" href={gh.issues(`Challenge step: ${n.title}`, `Problem ${problem.number}, step \`${n.id}\` (${n.file})\n\nWhat is wrong or missing, and what is the evidence?\n`)}><Icon name="flag" />Challenge this</a>
              <a class="btn btn-ghost" href={gh.history(n.file)}><Icon name="history" />History</a>
              <p class="data-sm muted file">{n.file}</p>
            </div>
          </section>
        );
      })}
    </aside>
  </div>

  <details class="outline">
    <summary class="label">View as outline</summary>
    <ul class="body-sm">
      {(() => {
        const render = (id: string): any => {
          const n = data.nodes[id];
          return (
            <li>
              <a href={`#${id}`} data-goto={id}>{n.title}</a> <span class="data-sm muted">{STATUS_LABEL[n.status]}{n.children.length > 0 && ` · ${n.logic}`}</span>
              {n.children.length > 0 && <ul>{n.children.map(render)}</ul>}
            </li>
          );
        };
        return render(data.root);
      })()}
    </ul>
  </details>
  <p class="body-sm muted note">The tree breaks the goal into the steps it needs. To add a step, create a file in <code class="data-sm">problems/{problem.slug}/map/nodes/</code> and list its id in a parent's <code class="data-sm">children</code>.</p>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-tree]')) {
    const parents: Record<string, string[]> = JSON.parse(root.dataset.parents || '{}');
    const select = (id: string, scroll = false) => {
      const card = root.querySelector<HTMLElement>(`[data-node="${CSS.escape(id)}"]`);
      if (!card) return;
      root.querySelectorAll('[data-node]').forEach((c) => c.classList.toggle('sel', c === card));
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== id));
      // Highlight the path from the root down to the selected step.
      const onPath = new Set<string>();
      const up = (n: string) => { for (const p of parents[n] ?? []) { onPath.add(`${p}>${n}`); up(p); } };
      up(id);
      root.querySelectorAll<SVGPathElement>('[data-edge]').forEach((e) => e.classList.toggle('on', onPath.has(e.dataset.edge!)));
      if (scroll) card.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
      history.replaceState(null, '', `#${id}`);
    };
    root.addEventListener('click', (ev) => {
      const t = (ev.target as HTMLElement).closest<HTMLElement>('[data-node],[data-goto]');
      if (!t) return;
      ev.preventDefault();
      select(t.dataset.node ?? t.dataset.goto!, !!t.dataset.goto);
    });
    const fromHash = () => {
      const h = decodeURIComponent(location.hash.slice(1));
      select(h && root.querySelector(`[data-node="${CSS.escape(h)}"]`) ? h : root.dataset.root!, !!h);
    };
    fromHash();
    window.addEventListener('hashchange', fromHash);
    // On phones the outline is easier to read than the wide graph.
    if (window.matchMedia('(max-width: 720px)').matches) root.querySelector('details.outline')?.setAttribute('open', '');
  }
</script>

<style>
  .tm { display: grid; gap: var(--space-4); margin-top: var(--space-6); }
  .bar { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-3); align-items: center; }
  .legend { display: flex; flex-wrap: wrap; gap: var(--space-4); }
  .legend span { display: inline-flex; gap: var(--space-2); align-items: center; }
  .meta { display: flex; gap: var(--space-3); align-items: center; flex-wrap: wrap; }
  .frame { display: grid; grid-template-columns: minmax(0, 1fr) 340px; border: var(--stroke-hairline) solid var(--line); background: var(--surface-0); }
  .canvas { overflow: auto; max-height: 78vh; }
  .graph { position: relative; }
  .graph svg { position: absolute; inset: 0; }
  .edge { fill: none; stroke: var(--line-strong); stroke-width: var(--stroke-hairline); }
  .edge.on { stroke: var(--signal); stroke-width: var(--stroke-path); }
  .or { fill: var(--ink-muted); }
  .card { position: absolute; display: flex; flex-direction: column; gap: 2px; text-align: left; font: inherit; color: var(--ink); background: var(--surface-1); border: var(--stroke-hairline) solid var(--line-strong); border-radius: var(--radius-sm); padding: var(--space-2) var(--space-3); cursor: pointer; overflow: hidden; }
  .card:hover { background: var(--surface-2); }
  .card.sel { background: var(--signal-tint); border: var(--stroke-path) solid var(--signal); padding: 7px 11px; }
  .card.goal .t { font-weight: 600; }
  .card .k, .card .s { color: var(--ink-muted); }
  .card .blk { color: var(--ink); font-weight: 500; }
  .card .t { font-size: 13px; line-height: 18px; font-weight: 500; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .card.impossible .t { text-decoration: line-through; }
  .inspector { background: var(--surface-1); border-left: var(--stroke-hairline) solid var(--line); padding: var(--space-4); overflow: auto; max-height: 78vh; }
  .panel-n { display: grid; gap: var(--space-3); }
  .sec { display: grid; gap: var(--space-2); justify-items: start; }
  .row { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; }
  .st { padding: var(--space-1) var(--space-2); border-radius: var(--radius-sm); background: var(--surface-2); color: var(--ink-muted); }
  .st.solved, .st.demonstrated { color: var(--positive); background: var(--positive-tint); }
  .st.impossible { color: var(--critical); background: var(--critical-tint); }
  .strong { font-weight: 600; }
  .unsupported { display: inline-flex; align-items: center; gap: var(--space-1); color: var(--caution); background: var(--caution-tint); border-radius: var(--radius-pill); padding: var(--space-1) var(--space-3); }
  .plain { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-1); }
  .gh { width: 100%; }
  .gh .btn { width: 100%; }
  .file { word-break: break-all; }
  .outline summary { cursor: pointer; }
  .outline ul { margin: var(--space-2) 0 0; padding-left: var(--space-6); }
  .outline li { margin: var(--space-1) 0; }
  .note code { background: var(--surface-2); padding: 0 var(--space-1); border-radius: var(--radius-sm); }
  @media (max-width: 900px) {
    .frame { grid-template-columns: 1fr; }
    .canvas { max-height: 60vh; }
    .inspector { border-left: 0; border-top: var(--stroke-hairline) solid var(--line); max-height: none; }
  }
</style>
