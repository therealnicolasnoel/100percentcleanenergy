---
/**
 * Universal tree map, four levels:
 *   problem (fixed) → sub-goals (curated by people) → steps (generated by the step
 *   scanner) → projects (from the project scanner and created by people).
 * Both layouts (with and without projects) are computed at build time; the browser
 * only switches between them and shows the selected item's panel.
 */
import ReviewBadge from './ReviewBadge.astro';
import SourceChip from './SourceChip.astro';
import Icon from './Icon.astro';
import { layoutTree, TREE, STATUS_LABEL, KIND_LABEL, type ProblemData, type Project, type TreeLayout } from '../lib/problemData';
import { problems, type Problem } from '../data/problems';
import { getField, GROUPS, landscape } from '../lib/field';
import { gh, url, formatDate } from '../site.config';

interface Props { data: ProblemData; problem: Problem }
const { data, problem } = Astro.props;
const layouts: { id: 'plain' | 'projects'; L: TreeLayout }[] = [
  { id: 'plain', L: layoutTree(data) },
  { id: 'projects', L: layoutTree(data, { projects: true }) },
];
const field = getField(problem.slug);
const land = field ? landscape(field, data) : null;
const activity = (id: string) => land?.rows.find((r) => r.id === id) ?? null;
const createUrl = (subgoal: string, step?: string, title?: string) =>
  url(`/problems/${problem.slug}/projects/new/?${new URLSearchParams({ subgoal, ...(step ? { step } : {}), ...(title ? { title } : {}) })}`);
const projByKey = new Map(data.projects.map((p) => [p.key, p]));
const nf = new Intl.NumberFormat('en');
const PROJECT_KIND: Record<Project['kind'], string> = { open_source: 'Open source', startup: 'Startup', research: 'Funded research', user: 'On Keystone' };
const STATUS_P: Record<string, string> = { idea: 'Idea', active: 'Active', paused: 'Paused', done: 'Done' };

// Organisations the field scan found per node, and top papers per step.
const orgsOn = (id: string) => (field?.orgs ?? []).filter((o) => o.steps[id]).sort((a, b) => b.steps[id] - a.steps[id]).slice(0, 8);
const papersOn = (id: string) => (field?.records ?? []).filter((r) => r.steps.includes(id) && ['paper', 'preprint', 'report'].includes(r.kind)).sort((a, b) => Number(b.metrics.citations ?? 0) - Number(a.metrics.citations ?? 0)).slice(0, 4);

const edgePath = (L: TreeLayout, from: string, to: string) => {
  const a = L.pos[from], b = L.pos[to];
  const x1 = a.x + TREE.cardW, y1 = a.y + a.h / 2, x2 = b.x, y2 = b.y + b.h / 2, mx = (x1 + x2) / 2;
  return `M${x1} ${y1} C${mx} ${y1} ${mx} ${y2} ${x2} ${y2}`;
};
const metricLine = (p: Project) => {
  const m = p.metrics;
  return [m.stars ? `${nf.format(Number(m.stars))} stars` : '', m.language ?? '', m.batch ? `YC ${m.batch}` : '', m.amount_usd ? `$${nf.format(Number(m.amount_usd))}` : '', p.status ? STATUS_P[p.status] : ''].filter(Boolean).join(' · ');
};
const subgoals = data.nodes[data.root].children;
const stepCount = data.order.filter((id) => data.nodes[id].type === 'step').length;
const unsupported = subgoals.filter((id) => !data.nodes[id].sources.length).length;
---
<div class="tm" data-tree data-root={data.root} data-parents={JSON.stringify(data.parents)}>
  <div class="bar">
    <div class="legend body-sm muted">
      <span><span class="sw goal"></span>Problem · fixed</span>
      <span><span class="sw subgoal"></span>Sub-goal · curated by people</span>
      <span><span class="sw step"></span>Step · generated by the scanners</span>
      <span><span class="sw project"></span>Project</span>
      <span><svg width="28" height="8" aria-hidden="true"><line x1="0" y1="4" x2="28" y2="4" stroke="var(--line-strong)" stroke-dasharray="4 4" /></svg> any one is enough</span>
    </div>
    <div class="meta">
      <div class="seg" role="tablist" aria-label="Detail">
        <button type="button" class="on" data-layout="plain" aria-selected="true">Steps</button>
        <button type="button" data-layout="projects" aria-selected="false">Steps and projects <span class="data-sm">{data.projects.length}</span></button>
      </div>
      <ReviewBadge status={data.meta.review.map} />
    </div>
  </div>
  <p class="body-sm muted note">
    {subgoals.length} curated sub-goals{unsupported ? ` (${unsupported} without a source)` : ''}, {stepCount} steps generated from the research topics under them{data.stepsAt ? ` on ${formatDate(new Date(data.stepsAt))}` : ''}, and {data.projects.length} projects. Select anything to see its evidence and projects.
  </p>

  <div class="frame">
    {layouts.map(({ id: lid, L }) => (
      <div class="canvas" data-canvas={lid} hidden={lid !== 'plain'} tabindex="-1">
        <div class="graph" style={`width:${L.width}px;height:${L.height}px`}>
          <svg width={L.width} height={L.height} aria-hidden="true">
            {L.edges.map((e) => <path d={edgePath(L, e.from, e.to)} data-edge={`${e.from}>${e.to}`} class:list={['edge', { proj: L.pos[e.to].kind === 'project' || L.pos[e.to].kind === 'more' }]} stroke-dasharray={e.or ? '4 4' : undefined} />)}
          </svg>
          {L.items.map((it) => {
            const style = `left:${it.x}px;top:${it.y}px;width:${TREE.cardW}px;height:${it.h}px`;
            if (it.kind === 'project') {
              const p = projByKey.get(it.ref)!;
              return (
                <button type="button" class:list={['card', 'project', p.kind]} data-node={it.id} data-panel-for={`p:${p.key}`} style={style} aria-label={p.title}>
                  <span class="k data-sm">{PROJECT_KIND[p.kind]}</span>
                  <span class="t1">{p.title}</span>
                </button>
              );
            }
            if (it.kind === 'more') {
              const n = (data.projectsOn[it.ref]?.length ?? 0) - 3;
              return <button type="button" class="card more" data-node={it.id} data-panel-for={it.ref} style={style}><span class="body-sm">+ {n} more projects</span></button>;
            }
            const n = data.nodes[it.ref];
            const a = activity(n.id);
            const pc = data.projectsOn[n.id]?.length ?? 0;
            return (
              <button type="button" class:list={['card', n.type, n.status, { blocker: n.blocker }]} data-node={it.id} data-panel-for={n.id} style={style} aria-label={n.title}>
                <span class="k data-sm">
                  {n.type === 'goal' && <><Icon name="flag" size={10} /> Problem · fixed</>}
                  {n.type === 'subgoal' && <>Sub-goal{n.children.length > 0 && n.logic === 'OR' && ' · any one'}{n.blocker && <span class="blk"> · main blocker</span>}</>}
                  {n.type === 'step' && <>Step · {n.papers} papers in the scan</>}
                </span>
                <span class="t">{n.title}</span>
                <span class="s data-sm">
                  {n.type === 'step' ? [a ? `${a.total} items` : '', pc ? `${pc} projects` : ''].filter(Boolean).join(' · ') : n.type === 'subgoal' ? `${STATUS_LABEL[n.status]} · ${n.children.length} steps` : `${subgoals.length} sub-goals`}
                </span>
              </button>
            );
          })}
        </div>
      </div>
    ))}

    <aside class="inspector" aria-live="polite">
      {data.order.map((id) => {
        const n = data.nodes[id];
        const who = (data.actorsOn[id] ?? []).map((a) => data.actorsById[a]);
        const found = orgsOn(id).filter((o) => !o.in_network);
        const a = activity(id);
        const projs = data.projectsOn[id] ?? [];
        const shared = n.shared_with.map((num) => problems.find((p) => p.number === num)!).filter(Boolean);
        const parentSub = n.type === 'step' ? n.parent! : n.type === 'subgoal' ? id : null;
        return (
          <section data-panel={id} class="pnl" hidden={id !== data.root}>
            <p class="label muted">
              {n.type === 'goal' && 'Problem · fixed'}
              {n.type === 'subgoal' && `Sub-goal · curated${n.logic === 'OR' ? ' · any one step is enough' : ''}`}
              {n.type === 'step' && <>Step · generated from {n.papers} papers under <a href={`#${n.parent}`} data-goto={n.parent}>{data.nodes[n.parent!].title}</a></>}
            </p>
            <h2 class="heading">{n.title}</h2>
            {n.type !== 'step' && (
              <div class="row">
                <span class:list={['st label', n.status]}>{STATUS_LABEL[n.status]}</span>
                {n.blocker && <span class="label tag strong">Main blocker</span>}
              </div>
            )}
            {n.description && <p class="body">{n.description}</p>}
            {n.type === 'goal' && <p class="body-sm muted">The problem statement is fixed. People curate the sub-goals; the scanners generate the steps under them from what researchers, builders and investors are working on; projects come from the scanners and from anyone who adds one.</p>}
            {parentSub && (
              <div class="sec">
                <p class="label muted">Projects <span class="data-sm">{projs.length}</span>{n.type === 'subgoal' && n.children.length > 0 && ' not under a step'}</p>
                {projs.length
                  ? <ul class="plain body-sm projs">{projs.slice(0, 10).map((p) => <li><a href={`#p:${p.key}`} data-goto={`p:${p.key}`}>{p.title}</a> <span class="data-sm muted">{PROJECT_KIND[p.kind]}{metricLine(p) && ` · ${metricLine(p)}`}</span></li>)}</ul>
                  : <p class="body-sm muted">None yet.</p>}
                {projs.length > 10 && <p class="body-sm muted">and {projs.length - 10} more in the scan.</p>}
                <a class="btn btn-primary" href={createUrl(parentSub, n.type === 'step' ? id : undefined)}><Icon name="plus" />Open a project here</a>
              </div>
            )}
            {n.type === 'step' && n.keywords && n.keywords.length > 0 && (
              <div class="sec"><p class="label muted">Topic keywords</p><div class="row">{n.keywords.slice(0, 10).map((k) => <span class="label tag">{k}</span>)}</div>
                {n.topic && <p class="body-sm muted">OpenAlex topic in {n.topic.subfield}{n.topic.works_count ? `, ${nf.format(n.topic.works_count)} works worldwide` : ''}. <a href={n.topic.url} target="_blank" rel="noopener">Open in OpenAlex</a></p>}
              </div>
            )}
            {n.bottlenecks.length > 0 && <div class="sec"><p class="label muted">Bottlenecks</p><div class="row">{n.bottlenecks.map((b) => <span class="label tag">{b}</span>)}</div></div>}
            {n.type !== 'step' && (
              <div class="sec"><p class="label muted">Evidence</p>
                {n.sources.length ? <div class="row">{n.sources.map((s) => <SourceChip {...s} />)}</div> : <span class="unsupported label"><Icon name="flag" size={12} />Unsupported: no source yet</span>}</div>
            )}
            {n.type === 'step' && papersOn(id).length > 0 && (
              <div class="sec"><p class="label muted">Most cited papers here</p>
                <ul class="plain body-sm">{papersOn(id).map((r) => <li>{r.url ? <a href={r.url} target="_blank" rel="noopener">{r.title}</a> : r.title} <span class="data-sm muted">{r.year} · {r.metrics.citations ?? 0} cit.</span></li>)}</ul></div>
            )}
            {n.children.length > 0 && (
              <div class="sec"><p class="label muted">{n.type === 'goal' ? 'Sub-goals' : 'Steps found by the scanners'}</p>
                <ul class="plain body-sm">{n.children.map((c) => <li><a href={`#${c}`} data-goto={c}>{data.nodes[c].title}</a>{data.nodes[c].papers ? <span class="data-sm muted"> {data.nodes[c].papers} papers</span> : ''}</li>)}</ul></div>
            )}
            {a && (
              <div class="sec"><p class="label muted">What's happening <span class="data-sm">{a.total} items</span></p>
                <p class="body-sm">{GROUPS.filter((g) => a.counts[g.id]).map((g) => `${a.counts[g.id]} ${g.label.toLowerCase()}`).join(' · ') || 'Nothing found yet.'}</p>
                <a class="body-sm" href={url(`/problems/${problem.slug}/field/#step=${id}`)}>See everything found here</a></div>
            )}
            <div class="sec"><p class="label muted">Who's working on this</p>
              {who.length > 0 && <ul class="plain body-sm">{who.map((x) => <li>{x.url ? <a href={x.url} target="_blank" rel="noopener">{x.name}</a> : x.name} <span class="muted">· {KIND_LABEL[x.kind]} · checked</span></li>)}</ul>}
              {found.length > 0 && <ul class="plain body-sm">{found.slice(0, 6).map((o) => <li>{o.url ? <a href={o.url} target="_blank" rel="noopener">{o.name}</a> : o.name} <span class="muted data-sm">{o.steps[id]} items</span></li>)}</ul>}
              {!who.length && !found.length && <p class="body-sm muted">Nobody found yet.</p>}
            </div>
            {shared.length > 0 && (
              <div class="sec"><p class="label muted">Shared with</p>
                <ul class="plain body-sm">{shared.map((p) => <li><span class="data-sm">{p.number}</span> {p.active ? <a href={url(`/problems/${p.slug}/map/`)}>{p.title}</a> : p.title}</li>)}</ul></div>
            )}
            <p class="links body-sm muted">
              {n.type === 'goal' && <>The title is fixed. <a href={gh.edit(n.file!)}>Suggest a better description</a></>}
              {n.type === 'subgoal' && <>Curated; changes need a maintainer's review. <a href={gh.edit(n.file!)}>Suggest a change</a> · <a href={gh.issues(`Challenge sub-goal: ${n.title}`, `Problem ${problem.number}, sub-goal \`${n.id}\` (${n.file})\n\nWhat is wrong or missing, and what is the evidence?\n`)}>Challenge it</a> · <a href={gh.history(n.file!)}>History</a></>}
              {n.type === 'step' && <>Generated by the scanners from research topics. <a href={gh.edit(`problems/${problem.slug}/scan.json`)}>Rename or hide it</a></>}
            </p>
          </section>
        );
      })}
      {data.projects.map((p) => (
        <section data-panel={`p:${p.key}`} class="pnl" hidden>
          <p class="label muted">{PROJECT_KIND[p.kind]} · {p.source}{p.category && ` · ${p.category}`}</p>
          <h2 class="heading">{p.title}</h2>
          {p.status && <div class="row"><span class="st label">{STATUS_P[p.status]}</span></div>}
          {p.description && <p class="body">{p.description}</p>}
          {p.url && !p.issue && <a class="body-sm" href={p.url} target="_blank" rel="noopener">{p.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a>}
          {metricLine(p) && <p class="data-sm muted">{metricLine(p)}</p>}
          {p.actors.length > 0 && <div class="sec"><p class="label muted">Organisations</p><p class="body-sm">{p.actors.join(', ')}</p></div>}
          {p.looking_for && p.looking_for.length > 0 && <div class="sec"><p class="label muted">Looking for</p><ul class="plain body-sm">{p.looking_for.map((x) => <li>{x}</li>)}</ul></div>}
          {p.contact && <div class="sec"><p class="label muted">Contact</p><p class="body-sm">{p.contact}</p></div>}
          <div class="sec"><p class="label muted">Serves</p>
            <ul class="plain body-sm">
              <li><a href={`#${p.subgoal}`} data-goto={p.subgoal}>{data.nodes[p.subgoal].title}</a></li>
              {p.step && <li>→ <a href={`#${p.step}`} data-goto={p.step}>{data.nodes[p.step].title}</a></li>}
            </ul>
          </div>
          {p.issue
            ? <a class="btn btn-primary" href={p.url!}>Open the project<Icon name="arrow" /></a>
            : p.file
            ? <a class="btn btn-secondary" href={gh.edit(p.file)}><Icon name="pencil" />Edit this project</a>
            : <p class="body-sm muted">Found by the project scanner. Working on it? <a href={createUrl(p.subgoal, p.step ?? undefined, p.title)}>Open it as a project here</a> to find people and track tasks.</p>}
        </section>
      ))}
    </aside>
  </div>

  <details class="outline">
    <summary class="label">View as outline</summary>
    <ul class="body-sm">
      {(() => {
        const render = (id: string): any => {
          const n = data.nodes[id];
          return (
            <li>
              <a href={`#${id}`} data-goto={id}>{n.title}</a> <span class="data-sm muted">{n.type === 'step' ? `step · ${n.papers} papers` : n.type === 'subgoal' ? 'sub-goal' : 'problem'}{(data.projectsOn[id]?.length ?? 0) > 0 && ` · ${data.projectsOn[id].length} projects`}</span>
              {n.children.length > 0 && <ul>{n.children.map(render)}</ul>}
            </li>
          );
        };
        return render(data.root);
      })()}
    </ul>
  </details>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-tree]')) {
    const parents: Record<string, string[]> = JSON.parse(root.dataset.parents || '{}');
    let layout = 'plain';
    let current = root.dataset.root!;
    const canvas = () => root.querySelector<HTMLElement>(`[data-canvas="${layout}"]`)!;
    const select = (panel: string, scroll = false) => {
      if (!root.querySelector(`[data-panel="${CSS.escape(panel)}"]`)) return;
      current = panel;
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== panel));
      const c = canvas();
      const card = c.querySelector<HTMLElement>(`[data-node="${CSS.escape(panel)}"]`) ?? c.querySelector<HTMLElement>(`[data-panel-for="${CSS.escape(panel)}"]`);
      c.querySelectorAll('[data-node]').forEach((el) => el.classList.toggle('sel', el === card));
      // Path from the problem down to the selected item.
      const on = new Set<string>();
      const up = (n: string) => { for (const p of parents[n] ?? []) { on.add(`${p}>${n}`); up(p); } };
      const id = card?.dataset.node ?? panel;
      const node = id.startsWith('p:') || id.startsWith('more:') ? null : id;
      if (node) up(node);
      else if (card) { const e = c.querySelector<SVGPathElement>(`[data-edge$=">${CSS.escape(id)}"]`); const from = e?.dataset.edge?.split('>')[0]; if (from) { on.add(e!.dataset.edge!); up(from); } }
      c.querySelectorAll<SVGPathElement>('[data-edge]').forEach((e) => e.classList.toggle('on', on.has(e.dataset.edge!)));
      if (scroll && card) card.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
      history.replaceState(null, '', `#${panel}`);
    };
    root.addEventListener('click', (ev) => {
      const t = ev.target as HTMLElement;
      const lay = t.closest<HTMLElement>('[data-layout]');
      if (lay) {
        layout = lay.dataset.layout!;
        root.querySelectorAll<HTMLElement>('[data-layout]').forEach((b) => { b.classList.toggle('on', b === lay); b.setAttribute('aria-selected', String(b === lay)); });
        root.querySelectorAll<HTMLElement>('[data-canvas]').forEach((c) => (c.hidden = c.dataset.canvas !== layout));
        select(current);
        return;
      }
      const el = t.closest<HTMLElement>('[data-panel-for],[data-goto]');
      if (!el) return;
      ev.preventDefault();
      const target = el.dataset.goto ?? el.dataset.panelFor!;
      // Jumping to a project from a panel needs the projects layout.
      if (target.startsWith('p:') && layout === 'plain' && el.dataset.goto) root.querySelector<HTMLElement>('[data-layout="projects"]')!.click();
      select(target, !!el.dataset.goto);
    });
    const fromHash = () => {
      const h = decodeURIComponent(location.hash.slice(1));
      if (h.startsWith('p:')) root.querySelector<HTMLElement>('[data-layout="projects"]')!.click();
      select(h && root.querySelector(`[data-panel="${CSS.escape(h)}"]`) ? h : root.dataset.root!, !!h);
    };
    fromHash();
    window.addEventListener('hashchange', fromHash);
    if (window.matchMedia('(max-width: 720px)').matches) root.querySelector('details.outline')?.setAttribute('open', '');
  }
</script>

<style>
  .tm { display: grid; gap: var(--space-3); margin-top: var(--space-6); }
  .bar { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-3); align-items: center; }
  .legend { display: flex; flex-wrap: wrap; gap: var(--space-4); }
  .legend span { display: inline-flex; gap: var(--space-2); align-items: center; }
  .sw { width: 14px; height: 10px; border-radius: var(--radius-sm); border: var(--stroke-hairline) solid var(--line-strong); background: var(--surface-1); }
  .sw.goal { background: var(--ink); border-color: var(--ink); }
  .sw.subgoal { border-width: var(--stroke-path); border-color: var(--ink); }
  .sw.step { border-style: dashed; }
  .sw.project { background: var(--surface-2); border-color: var(--line); }
  .meta { display: flex; gap: var(--space-3); align-items: center; flex-wrap: wrap; }
  .seg { display: inline-flex; border: var(--stroke-hairline) solid var(--line-strong); border-radius: var(--radius-sm); overflow: hidden; }
  .seg button { font: inherit; font-size: 13px; font-weight: 500; color: var(--ink); background: var(--surface-1); border: 0; padding: var(--space-1) var(--space-3); cursor: pointer; }
  .seg button + button { border-left: var(--stroke-hairline) solid var(--line-strong); }
  .seg button.on { background: var(--ink); color: var(--surface-0); }
  .frame { display: grid; grid-template-columns: minmax(0, 1fr) 360px; border: var(--stroke-hairline) solid var(--line); background: var(--surface-0); }
  .canvas { overflow: auto; max-height: 80vh; grid-column: 1; grid-row: 1; }
  .graph { position: relative; }
  .graph svg { position: absolute; inset: 0; }
  .edge { fill: none; stroke: var(--line-strong); stroke-width: var(--stroke-hairline); }
  .edge.proj { stroke: var(--line); }
  .edge.on { stroke: var(--signal); stroke-width: var(--stroke-path); }
  .card { position: absolute; display: flex; flex-direction: column; gap: 2px; text-align: left; font: inherit; color: var(--ink); background: var(--surface-1); border: var(--stroke-hairline) solid var(--line-strong); border-radius: var(--radius-sm); padding: var(--space-2) var(--space-3); cursor: pointer; overflow: hidden; }
  .card:hover { background: var(--surface-2); }
  .card .k, .card .s { color: var(--ink-muted); display: inline-flex; gap: 4px; align-items: center; }
  .card .t { font-size: 13px; line-height: 18px; font-weight: 500; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .card .t1 { font-size: 12px; line-height: 16px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .card.goal { background: var(--ink); border-color: var(--ink); color: var(--surface-0); }
  .card.goal .k, .card.goal .s { color: var(--surface-2); }
  .card.goal .t { font-weight: 600; }
  .card.subgoal { border: var(--stroke-path) solid var(--ink); padding: 7px 11px; }
  .card.subgoal .t { font-weight: 600; }
  .card.subgoal .blk { color: var(--ink); font-weight: 500; }
  .card.step { border-style: dashed; }
  .card.project { background: var(--surface-2); border-color: var(--line); padding: 4px 10px; gap: 0; }
  .card.project.user { border-color: var(--ink); border-style: solid; }
  .card.more { background: none; border: var(--stroke-hairline) dashed var(--line); justify-content: center; color: var(--signal); }
  .card.sel { background: var(--signal-tint); border: var(--stroke-path) solid var(--signal); color: var(--ink); }
