---
// Small line icons (stroke-mark), 12–16px. No emoji in the UI.
interface Props { name: 'github' | 'check' | 'flag' | 'dotted' | 'pencil' | 'history' | 'plus' | 'arrow' | 'doc'; size?: number }
const { name, size = 14 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'github' && <path d="M6 13c-3 1-3-1.5-4-2m8 3.5V12c0-.8.1-1.2-.4-1.6 1.9-.2 3.9-1 3.9-4.3 0-.9-.3-1.7-.9-2.3.1-.3.4-1.2-.1-2.3 0 0-.7-.2-2.4.9a8 8 0 0 0-4.2 0C4.2 1.3 3.5 1.5 3.5 1.5c-.5 1.1-.2 2-.1 2.3-.6.6-.9 1.4-.9 2.3 0 3.3 2 4.1 3.9 4.3-.4.4-.4.9-.4 1.6v2.5" />}
  {name === 'check' && <path d="M3 8.5l3 3 7-7" />}
  {name === 'flag' && <path d="M3.5 14V2.5m0 0h8l-1.5 3 1.5 3h-8" />}
  {name === 'dotted' && <circle cx="8" cy="8" r="5.5" stroke-dasharray="2 2" />}
  {name === 'pencil' && <path d="M10.5 2.5l3 3L6 13H3v-3z" />}
  {name === 'history' && <><path d="M2.5 8a5.5 5.5 0 1 0 1.6-3.9M2.5 2.5v2.5H5" /><path d="M8 5v3l2 1.5" /></>}
  {name === 'plus' && <path d="M8 3v10M3 8h10" />}
  {name === 'arrow' && <path d="M3 8h10m-4-4 4 4-4 4" />}
  {name === 'doc' && <><path d="M4 1.5h5.5L12.5 4.5v10h-8.5z" /><path d="M6.5 8h4M6.5 10.5h4" /></>}
</svg>
