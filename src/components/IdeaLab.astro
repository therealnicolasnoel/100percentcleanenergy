  .seg button { font: inherit; font-size: 13px; font-weight: 500; color: var(--ink); background: var(--surface-1); border: 0; padding: var(--space-2) var(--space-3); cursor: pointer; }
  .seg button + button { border-left: var(--stroke-hairline) solid var(--line-strong); }
  .seg button.on { background: var(--ink); color: var(--surface-0); }
  .pane { display: grid; gap: var(--space-3); }
  label.label { display: grid; gap: var(--space-1); }
  select, textarea { font: inherit; font-size: 14px; color: var(--ink); background: var(--surface-0); border: var(--stroke-hairline) solid var(--line-strong); border-radius: var(--radius-sm); padding: var(--space-2) var(--space-3); max-width: 100%; }
  textarea { width: 100%; resize: vertical; }
  .status { justify-content: space-between; align-items: center; border-top: var(--stroke-hairline) solid var(--line); padding-top: var(--space-3); }
