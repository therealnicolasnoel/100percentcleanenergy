  .seen summary { cursor: pointer; }
  .seen pre { white-space: pre-wrap; overflow-wrap: anywhere; background: var(--surface-2); padding: var(--space-3); border-radius: var(--radius-sm); max-height: 420px; overflow: auto; margin-top: var(--space-2); }
</style>
