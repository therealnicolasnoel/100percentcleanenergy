---
/**
 * Ideate with a local model: find new projects, new angles, and validate ideas,
 * with every section of the problem as context. The model (LFM3-1.7B) runs in the
 * browser through Transformers.js on WebGPU; nothing typed here leaves the page.
 * Numbers come from the Monte Carlo simulator, not from the model.
 */
import Icon from './Icon.astro';
import type { IdeaContext } from '../lib/ideation';
import type { SimModel } from '../lib/simulate';
import type { Problem } from '../data/problems';
import { gh, url } from '../site.config';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

interface Props { ctx: IdeaContext; model: SimModel; problem: Problem }
const { ctx, model, problem } = Astro.props;
const tmpl = JSON.parse(readFileSync(join(process.cwd(), 'templates', 'project.json'), 'utf8'));
const payload = {
  ctx,
  model,
  links: {
    tree: url(`/problems/${problem.slug}/map/`),
    newFile: gh.newFile(`problems/${problem.slug}/projects/__ID__.json`, '__BODY__'),
  },
  template: tmpl,
};
const tokens = Math.round(ctx.chars / 4 / 100) * 100;
---
<section class="lab" data-lab>
  <script type="application/json" data-payload set:html={JSON.stringify(payload).replace(/</g, '\\u003c')} />
  <div class="lab-head">
    <div>
      <h2 class="display-l">Ideate</h2>
      <p class="body muted">Find new projects and angles, and test ideas against everything on this page: the tree, the forecast, the projects, who's working on it and the state of the field. A small language model runs in your browser; nothing you type leaves this page.</p>
    </div>
    <div class="model-card">
      <p class="label muted">Model</p>
      <p class="body-sm"><a href="https://huggingface.co/onnx-community/LFM3-1.7B-ONNX" target="_blank" rel="noopener">LFM3-1.7B</a> by Liquid AI, 4-bit, via <a href="https://huggingface.co/docs/transformers.js" target="_blank" rel="noopener">Transformers.js</a></p>
      <p class="data-sm muted">≈1.1 GB, downloaded once and cached · reads ≈{tokens.toLocaleString('en')} tokens of context</p>
    </div>
  </div>

  <div class="gate" data-gate>
    <p class="body-sm" data-gate-msg>Load the model to start. It needs a browser with WebGPU (recent Chrome, Edge or Safari) and about 2 GB of free memory.</p>
    <div class="row">
      <button type="button" class="btn btn-secondary" data-load><Icon name="arrow" />Load the model (1.1 GB)</button>
      <button type="button" class="btn btn-ghost" data-load-cpu hidden>Run on the CPU instead (much slower)</button>
    </div>
    <div class="progress" data-progress hidden><span data-bar></span></div>
    <p class="data-sm muted" data-progress-text></p>
  </div>

  <div class="work" data-work hidden>
    <div class="seg" role="tablist" aria-label="Mode">
      <button type="button" class="on" data-mode="projects" aria-selected="true">New projects</button>
      <button type="button" data-mode="angles" aria-selected="false">New angles</button>
      <button type="button" data-mode="validate" aria-selected="false">Validate an idea</button>
      <button type="button" data-mode="ask" aria-selected="false">Ask</button>
    </div>

    <div class="pane" data-pane="projects">
      <div class="row">
        <label class="label">Focus
          <select data-focus>
            <option value="">Where the forecast says to start</option>
            {ctx.subgoals.map((s) => <option value={s.id}>{s.title}</option>)}
          </select>
        </label>
        <button type="button" class="btn btn-primary" data-run="projects">Suggest projects</button>
      </div>
      <div class="ideas" data-ideas></div>
    </div>

    <div class="pane" data-pane="angles" hidden>
      <div class="row">
        <label class="label">Focus
          <select data-focus-angles>
            <option value="">The whole problem</option>
            {ctx.subgoals.map((s) => <option value={s.id}>{s.title}</option>)}
          </select>
        </label>
        <button type="button" class="btn btn-secondary" data-run="angles">Find angles</button>
      </div>
      <div class="out body" data-out-angles></div>
    </div>

    <div class="pane" data-pane="validate" hidden>
      <label class="label">Your idea
        <textarea rows="3" data-idea placeholder="For example: an open dataset of grid connection queues across EU countries, updated monthly from TSO publications"></textarea>
      </label>
      <div class="row"><button type="button" class="btn btn-secondary" data-run="validate">Validate</button></div>
      <div class="verdict" data-verdict hidden></div>
    </div>

    <div class="pane" data-pane="ask" hidden>
      <div class="chat" data-chat></div>
      <label class="label">Question
        <textarea rows="2" data-question placeholder="Which steps have money but no open-source projects?"></textarea>
      </label>
      <div class="row"><button type="button" class="btn btn-secondary" data-run="ask">Ask</button><button type="button" class="btn btn-ghost" data-clear>Clear</button></div>
    </div>

    <div class="status row">
      <span class="data-sm muted" data-status></span>
      <label class="check body-sm"><input type="checkbox" data-think /> Reason first (slower, sometimes better)</label>
      <button type="button" class="btn btn-ghost" data-stop hidden>Stop</button>
    </div>
  </div>

  <details class="seen">
    <summary class="label">What the model sees ({ctx.chars.toLocaleString('en')} characters)</summary>
    <pre class="data-sm">{ctx.text}</pre>
  </details>
  <p class="body-sm muted">A 1.7B-parameter model can be wrong or overconfident: check suggestions against the sources. Placement and critique come from the model; the chance-of-success numbers come from the simulator and rest on its assumptions. The model is under the <a href="https://huggingface.co/LiquidAI/LFM3-1.7B/blob/main/LICENSE" target="_blank" rel="noopener">LFM Open License</a>.</p>
</section>

<script>
  import { simulate, pBy, DEFAULT_SCENARIO, type SimModel } from '../lib/simulate';

  type Ctx = { text: string; target: number; subgoals: { id: string; title: string; description: string; terms: string[] }[]; steps: { id: string; title: string; subgoal: string; keywords: string[] }[]; projects: { key: string; title: string; subgoal: string; step: string | null; kind: string; text: string; url: string | null }[]; orgs: { name: string; type: string; steps: string[]; url: string | null }[]; focusSteps: { id: string; subgoal: string; count: number }[]; bottleneck: string | null };
  type Msg = { role: 'system' | 'user' | 'assistant'; content: string };

  for (const root of document.querySelectorAll<HTMLElement>('[data-lab]')) {
    const P = JSON.parse(root.querySelector('[data-payload]')!.textContent!);
    const ctx: Ctx = P.ctx;
    const simModel: SimModel = P.model;
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const title = (id: string) => ctx.subgoals.find((s) => s.id === id)?.title ?? ctx.steps.find((s) => s.id === id)?.title ?? id;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    // Light formatting for streamed text: headings, bullets, bold.
    const fmt = (s: string) => esc(s).split('\n').map((l) => {
      const b = l.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
      if (/^#{1,4}\s/.test(l)) return `<p class="h">${b.replace(/^#{1,4}\s/, '')}</p>`;
      if (/^\s*[-*•]\s/.test(l)) return `<p class="li">${b.replace(/^\s*[-*•]\s/, '')}</p>`;
      return l.trim() ? `<p>${b}</p>` : '';
    }).join('');

    const SYSTEM = `You help people find and test projects that move one problem forward. Use only the brief below. When something isn't in the brief, say so instead of guessing. Name sub-goals, steps, projects and organisations exactly as the brief does, by name: never show the ids in square brackets to the reader. Be concrete and brief, plain language, no hype.\n\n${ctx.text}`;
    const IDS = `Sub-goal ids: ${ctx.subgoals.map((s) => s.id).join(', ')}. Step ids: ${ctx.steps.map((s) => `${s.id} (${s.title}, under ${s.subgoal})`).join('; ')}.`;

    // ---------------------------------------------------------------- model
    let worker: Worker | null = null;
    let seq = 0;
    const waiting = new Map<number, { onToken: (t: string) => void; resolve: (t: string) => void; reject: (e: Error) => void }>();
    const status = (s: string) => ($('[data-status]').textContent = s);
    const busy = (on: boolean) => {
      $('[data-stop]').hidden = !on;
      root.querySelectorAll<HTMLButtonElement>('[data-run]').forEach((b) => (b.disabled = on));
    };

    const start = async (device: 'webgpu' | 'wasm') => {
      let dtype: 'q4f16' | 'q4' = 'q4';
      if (device === 'webgpu') {
        const gpu = (navigator as Navigator & { gpu?: { requestAdapter: () => Promise<{ features: Set<string> } | null> } }).gpu;
        const adapter = gpu ? await gpu.requestAdapter() : null;
        if (!adapter) {
          $('[data-gate-msg]').textContent = "This browser doesn't offer WebGPU, so the model can't use your graphics chip. Try recent Chrome, Edge or Safari, or run it on the CPU (minutes per answer).";
          $('[data-load-cpu]').hidden = false;
          return;
        }
        dtype = adapter.features.has('shader-f16') ? 'q4f16' : 'q4';
      }
      worker = new Worker(new URL('../scripts/llm-worker.ts', import.meta.url), { type: 'module' });
      $('[data-load]').setAttribute('disabled', '');
      $('[data-progress]').hidden = false;
      $('[data-progress-text]').textContent = 'Starting…';
      worker.addEventListener('message', (ev) => {
        const m = ev.data;
        if (m.type === 'progress' && m.total) {
          const pct = Math.min(100, (m.loaded / m.total) * 100);
          ($('[data-bar]') as HTMLElement).style.width = `${pct}%`;
          $('[data-progress-text]').textContent = `${(m.loaded / 1e9).toFixed(2)} of ${(m.total / 1e9).toFixed(2)} GB${pct >= 99.9 ? ' · preparing the model on your device…' : ''}`;
        } else if (m.type === 'ready') {
          $('[data-gate]').hidden = true;
          $('[data-work]').hidden = false;
          status(`Ready on ${m.device === 'webgpu' ? 'your GPU' : 'your CPU'}.`);
        } else if (m.type === 'token') waiting.get(m.id)?.onToken(m.text);
        else if (m.type === 'done') { waiting.get(m.id)?.resolve(m.text); waiting.delete(m.id); }
        else if (m.type === 'error') {
          if (m.id !== undefined && waiting.has(m.id)) { waiting.get(m.id)!.reject(new Error(m.message)); waiting.delete(m.id); }
          else { $('[data-gate-msg]').textContent = `The model couldn't load: ${m.message}`; $('[data-load]').removeAttribute('disabled'); $('[data-load-cpu]').hidden = false; }
        }
      });
      worker.postMessage({ type: 'load', device, dtype });
    };
    $('[data-load]').addEventListener('click', () => start('webgpu'));
    $('[data-load-cpu]').addEventListener('click', () => start('wasm'));

    const generate = (messages: Msg[], onToken: (t: string) => void, options: Record<string, unknown> = {}) =>
      new Promise<string>((resolve, reject) => {
        const id = ++seq;
        waiting.set(id, { onToken, resolve, reject });
        worker!.postMessage({ type: 'generate', id, messages, options: { think: ($('[data-think]') as HTMLInputElement).checked, ...options } });
      });
    $('[data-stop]').addEventListener('click', () => worker?.postMessage({ type: 'interrupt' }));
    // Reasoning output, when on, comes before the answer: hide it from the visible text.
    const visible = (s: string) => s.replace(/<think>[\s\S]*?(<\/think>|$)/g, '').trim();
    const parseJson = <T,>(s: string, open: '[' | '{'): T | null => {
      const t = visible(s);
      const a = t.indexOf(open), b = t.lastIndexOf(open === '[' ? ']' : '}');
      if (a < 0 || b <= a) return null;
      try { return JSON.parse(t.slice(a, b + 1).replace(/,\s*([}\]])/g, '$1')); } catch { return null; }
    };
    const run = async (label: string, fn: () => Promise<void>) => {
      busy(true);
      const t0 = performance.now();
      status(`${label}: reading the problem's brief…`);
      try { await fn(); status(`Done in ${((performance.now() - t0) / 1000).toFixed(0)} s.`); }
      catch (e) { status(`Something went wrong: ${(e as Error).message}`); }
      finally { busy(false); }
    };
    const streaming = (label: string) => { let n = 0; return () => { n++; if (n % 8 === 1) status(`${label}: writing…`); }; };

    // ---------------------------------------------------------------- modes
    root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.addEventListener('click', () => {
      root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((x) => { x.classList.toggle('on', x === b); x.setAttribute('aria-selected', String(x === b)); });
      root.querySelectorAll<HTMLElement>('[data-pane]').forEach((p) => (p.hidden = p.dataset.pane !== b.dataset.mode));
    }));

    // Deterministic checks the page does itself.
    const STOP = new Set('a an and are as at be by for from has have in into is it its of on or that the to with this these our we will can new open data project projects using use based'.split(' '));
    const words = (s: string) => new Set(s.toLowerCase().split(/[^a-z0-9]+/).filter((w) => w.length > 2 && !STOP.has(w)));
    const similar = (text: string) => {
      const q = words(text);
      return ctx.projects.map((p) => {
        const w = words(p.text);
        let n = 0; for (const x of q) if (w.has(x)) n++;
        return { p, s: n / Math.max(4, Math.sqrt(q.size * w.size)) };
      }).filter((x) => x.s > 0.12).sort((a, b) => b.s - a.s).slice(0, 4).map((x) => x.p);
    };
    const placeByWords = (text: string) => {
      const q = words(text);
      const scored = ctx.steps.map((s) => { const w = words(`${s.title} ${s.keywords.join(' ')}`); let n = 0; for (const x of q) if (w.has(x)) n++; return { s, n }; }).sort((a, b) => b.n - a.n);
      return scored[0]?.n ? { subgoal: scored[0].s.subgoal, step: scored[0].s.id } : { subgoal: ctx.subgoals[0].id, step: '' };
    };
    const impact = (subgoal: string, step: string) => {
      const base = { ...DEFAULT_SCENARIO, runs: 3000 };
      const unitKnown = simModel.subs.some((s) => s.units.some((u) => u.id === step));
      const a = simulate(simModel, base);
      const b = simulate(simModel, unitKnown ? { ...base, extraUnits: { [step]: 1 } } : { ...base, extra: { [subgoal]: 1 } });
      const b3 = simulate(simModel, unitKnown ? { ...base, extraUnits: { [step]: 3 } } : { ...base, extra: { [subgoal]: 3 } });
      return { p0: pBy(a, ctx.target), p1: pBy(b, ctx.target), p3: pBy(b3, ctx.target), m0: a.q.p50, m1: b.q.p50 };
    };
    const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_|_$/g, '').slice(0, 40) || 'new_project';
    const createLink = (o: { title: string; description: string; subgoal: string; step?: string; looking_for?: string[] }) => {
      const body = JSON.stringify({ ...P.template, id: slug(o.title), title: o.title, description: o.description, subgoal: o.subgoal, step: o.step ?? '', status: 'idea', looking_for: o.looking_for?.length ? o.looking_for : P.template.looking_for }, null, 2) + '\n';
      return P.links.newFile.replace('__ID__', slug(o.title)).replace(encodeURIComponent('__BODY__'), encodeURIComponent(body));
    };
    const where = (subgoal: string, step?: string) => `<a href="${P.links.tree}#${esc(subgoal)}">${esc(title(subgoal))}</a>${step ? ` → <a href="${P.links.tree}#${esc(step)}">${esc(title(step))}</a>` : ''}`;
    const validIds = (sg: string, st: string) => {
      const s = ctx.subgoals.find((x) => x.id === sg) ? sg : ctx.steps.find((x) => x.id === st)?.subgoal ?? '';
      const stp = ctx.steps.find((x) => x.id === st && x.subgoal === s) ? st : '';
      return s ? { subgoal: s, step: stp } : null;
    };

    // New projects: structured suggestions, each with Validate and Create.
    $('[data-run="projects"]').addEventListener('click', () => run('Suggesting projects', async () => {
      const focus = ($('[data-focus]') as HTMLSelectElement).value;
      const box = $('[data-ideas]');
      box.innerHTML = '<p class="body-sm muted">Thinking about where new projects would help most…</p>';
      const where0 = focus
        ? `Focus on the sub-goal "${title(focus)}" (${focus}) and its steps.`
        : `Put at least two of them on these steps, where the forecast says new projects raise the chance most: ${ctx.focusSteps.map((x) => `${title(x.id)} (${x.id})`).join('; ')}. Use the bottleneck or steps with no projects for the rest.`;
      const prompt = `Suggest 4 NEW projects that would most raise the chance of reaching the goal. ${where0} A new project is something nobody in the brief is doing yet: give it a new descriptive name, never the name of a project or organisation already in the brief. If it builds on an existing project, name that project in "builds_on". ${IDS}\nReply with only a JSON array, no other text: [{"title": "new descriptive name in plain words, 2 to 6 words", "subgoal": "<sub-goal id>", "step": "<step id or empty>", "what": "one sentence", "why": "one sentence that cites the brief", "builds_on": "existing project name or empty", "first_step": "one concrete action"}]`;
      const out = await generate([{ role: 'system', content: SYSTEM }, { role: 'user', content: prompt }], streaming('Suggesting projects'), { max_new_tokens: 900 });
      const ideas = (parseJson<{ title: string; subgoal: string; step: string; what: string; why: string; builds_on?: string; first_step: string }[]>(out, '[') ?? []).filter((x) => x && x.title);
      // A small model sometimes reuses an existing project's name: say so instead of presenting it as new.
      const norm = (x: string) => x.toLowerCase().replace(/[^a-z0-9]+/g, '');
      const tracked = new Map(ctx.projects.map((p) => [norm(p.title), p.title]));
      for (const x of ideas) {
        const hit = tracked.get(norm(x.title));
        if (hit) { x.builds_on = x.builds_on || hit; x.title = `${x.title} (extension)`; }
      }
      if (!ideas.length) { box.innerHTML = `<div class="out">${fmt(visible(out))}</div>`; return; }
      box.innerHTML = ideas.map((x, i) => {
        const w = validIds(x.subgoal, x.step) ?? placeByWords(`${x.title} ${x.what}`);
        return `<article class="idea" data-i="${i}"><h3 class="subheading">${esc(x.title)}</h3><p class="body-sm">${esc(x.what ?? '')}</p><p class="body-sm muted"><strong>Why:</strong> ${esc(x.why ?? '')}</p>${x.builds_on ? `<p class="body-sm muted"><strong>Builds on:</strong> ${esc(x.builds_on)} (already tracked)</p>` : ''}<p class="body-sm muted"><strong>First step:</strong> ${esc(x.first_step ?? '')}</p><p class="body-sm where">${where(w.subgoal, w.step)}</p><p class="acts"><button type="button" class="btn btn-secondary" data-validate-idea="${i}">Validate</button><a class="btn btn-ghost" target="_blank" rel="noopener" href="${createLink({ title: x.title, description: `${x.what ?? ''} ${x.why ?? ''}`.trim(), subgoal: w.subgoal, step: w.step })}">Create on GitHub</a></p></article>`;
      }).join('');
      box.querySelectorAll<HTMLButtonElement>('[data-validate-idea]').forEach((b) => b.addEventListener('click', () => {
        const x = ideas[Number(b.dataset.validateIdea)];
        ($('[data-idea]') as HTMLTextAreaElement).value = `${x.title}: ${x.what}`;
        root.querySelector<HTMLButtonElement>('[data-mode="validate"]')!.click();
        $('[data-run="validate"]').click();
      }));
    }));

    // New angles: streamed text.
    $('[data-run="angles"]').addEventListener('click', () => run('Finding angles', async () => {
      const focus = ($('[data-focus-angles]') as HTMLSelectElement).value;
      const out = $('[data-out-angles]');
      out.innerHTML = '';
      let acc = '';
      const tick = streaming('Finding angles');
      const prompt = `Find 4 angles on ${focus ? `the sub-goal "${title(focus)}"` : 'this problem'} that the projects and organisations in the brief are missing. Look for: a step with activity but no projects, a funding or policy route nobody is using, two existing projects or organisations that should be combined, or a lesson from the most cited research. For each angle write a short heading, then two sentences that cite the brief.`;
      await generate([{ role: 'system', content: SYSTEM }, { role: 'user', content: prompt }], (t) => { acc += t; tick(); out.innerHTML = fmt(visible(acc)); });
    }));

    // Validate: place (model), measure (simulator), compare (page), critique (model).
    $('[data-run="validate"]').addEventListener('click', () => run('Validating', async () => {
      const idea = ($('[data-idea]') as HTMLTextAreaElement).value.trim();
      const box = $('[data-verdict]');
      if (!idea) { status('Describe your idea first.'); return; }
      box.hidden = false;
      box.innerHTML = '<p class="body-sm muted">Placing the idea in the tree…</p>';
      // Placing only needs the tree, not the whole brief: a short prompt keeps this step fast.
      const TREE = `You place ideas in the tree of one problem. Choose the sub-goal by what it covers (its description and terms), not by the step names alone. Sub-goals and their steps:\n${ctx.subgoals.map((sg) => `- ${sg.id}: ${sg.title}. Covers: ${sg.description} Terms: ${sg.terms.slice(0, 14).join(', ')}.\n${ctx.steps.filter((st) => st.subgoal === sg.id).map((st) => `  - ${st.id}: ${st.title} (${st.keywords.slice(0, 4).join(', ')})`).join('\n')}`).join('\n')}`;
      const placeOut = await generate([{ role: 'system', content: TREE }, { role: 'user', content: `Place this idea in the tree.\nIdea: """${idea}"""\n${IDS}\nReply with only JSON, no other text: {"title": "short name", "subgoal": "<sub-goal id>", "step": "<step id under that sub-goal, or empty>", "kind": "open source | startup | research | policy | community", "assumptions": ["2 or 3 things that must be true for it to work"]}` }], streaming('Placing'), { max_new_tokens: 260 });
      const pj = parseJson<{ title?: string; subgoal?: string; step?: string; kind?: string; assumptions?: string[] }>(placeOut, '{') ?? {};
      let w = validIds(pj.subgoal ?? '', pj.step ?? '') ?? placeByWords(idea);
      // Backstop: if the idea clearly matches another sub-goal's search terms and none of
      // the chosen one's, trust the terms people wrote.
      const termHits = (sg: { terms: string[] }) => sg.terms.filter((tm) => new RegExp(`(^|[^a-z0-9])${tm.toLowerCase().replace(/[.*+?^${}()|[\]\\]/g, '\\$&').replace(/[-\s]+/g, '[-\\s]?')}`, 'i').test(idea)).length;
      const ranked = ctx.subgoals.map((sg) => ({ id: sg.id, n: termHits(sg) })).sort((a, b) => b.n - a.n);
      let overridden = false;
      if (ranked[0].n >= 1 && ranked[0].id !== w.subgoal && (ranked.find((r) => r.id === w.subgoal)?.n ?? 0) === 0) {
        const steps = ctx.steps.filter((st) => st.subgoal === ranked[0].id);
        const best = placeByWords(idea);
        w = { subgoal: ranked[0].id, step: steps.some((st) => st.id === best.step) ? best.step : '' };
        overridden = true;
      }
      const name = pj.title || idea.slice(0, 60);
      const im = impact(w.subgoal, w.step);
      const sim = similar(idea);
      const orgs = ctx.orgs.filter((o) => o.steps.includes(w.step) || o.steps.includes(w.subgoal)).slice(0, 6);
      const pts = (x: number) => `${x >= 0 ? '+' : ''}${(x * 100).toFixed(1)} pts`;
      box.innerHTML = `
        <h3 class="subheading">${esc(name)}</h3>
        <p class="body-sm where">${where(w.subgoal, w.step)}${pj.kind ? ` · ${esc(pj.kind)}` : ''}${overridden ? ' · <span class="muted">placed by the sub-goal\'s search terms</span>' : ''}</p>
        <dl class="nums">
          <div><dt class="label muted">One project like this</dt><dd class="numeral">${pts(im.p1 - im.p0)}</dd><dd class="data-sm muted">chance by ${ctx.target}: ${Math.round(im.p0 * 100)}% → ${Math.round(im.p1 * 100)}%</dd></div>
          <div><dt class="label muted">Three like it</dt><dd class="numeral">${pts(im.p3 - im.p0)}</dd><dd class="data-sm muted">from the Monte Carlo simulator</dd></div>
          <div><dt class="label muted">Similar projects already tracked</dt><dd class="body-sm">${sim.length ? sim.map((p) => p.url ? `<a href="${esc(p.url)}" target="_blank" rel="noopener">${esc(p.title)}</a>` : esc(p.title)).join('<br>') : 'None found'}</dd></div>
          <div><dt class="label muted">Organisations on this step</dt><dd class="body-sm">${orgs.length ? orgs.map((o) => esc(o.name)).join('<br>') : 'None found'}</dd></div>
        </dl>
        ${Math.abs(im.p3 - im.p0) < 0.005 && ctx.bottleneck && ctx.bottleneck !== w.subgoal ? `<p class="body-sm muted">Little change in the forecast: this sub-goal is done only when all its steps are, and in most simulated futures the goal waits on <a href="${P.links.tree}#${esc(ctx.bottleneck)}">${esc(title(ctx.bottleneck))}</a>, not on this. The idea can still matter; the forecast just says it won't change the date on its own.</p>` : ''}
        ${pj.assumptions?.length ? `<p class="label muted">Assumptions to test</p><ul class="body-sm">${pj.assumptions.map((a) => `<li>${esc(a)}</li>`).join('')}</ul>` : ''}
        <div class="out body" data-critique><p class="body-sm muted">Writing the assessment…</p></div>
        <p class="acts" data-create></p>`;
      let acc = '';
      const tick = streaming('Assessing');
      const facts = `Idea: """${idea}"""\nPlacement: sub-goal "${title(w.subgoal)}"${w.step ? `, step "${title(w.step)}"` : ''}.\nSimulator (illustrative): one active project like this changes the chance of reaching the goal by ${ctx.target} from ${Math.round(im.p0 * 100)}% to ${Math.round(im.p1 * 100)}% (${pts(im.p1 - im.p0)}); three would give ${pts(im.p3 - im.p0)}.\nSimilar existing projects: ${sim.map((p) => p.title).join('; ') || 'none found'}.\nOrganisations on this step: ${orgs.map((o) => o.name).join('; ') || 'none found'}.\nAssumptions: ${(pj.assumptions ?? []).join('; ') || 'not stated'}.`;
      await generate([{ role: 'system', content: SYSTEM }, { role: 'user', content: `${facts}\n\nAssess this idea using only the brief and these facts. Write four short sections with these headings: Fit (does it work on the bottleneck, a step the forecast says to start on, or an empty step?), Novelty (how it differs from the similar projects, or say plainly if it duplicates one), Risks (which assumptions are most likely to fail and why), First steps (two concrete actions, naming organisations from the brief to approach).` }], (t) => { acc += t; tick(); box.querySelector<HTMLElement>('[data-critique]')!.innerHTML = fmt(visible(acc)); });
      box.querySelector<HTMLElement>('[data-create]')!.innerHTML = `<a class="btn btn-secondary" target="_blank" rel="noopener" href="${createLink({ title: name, description: idea, subgoal: w.subgoal, step: w.step, looking_for: pj.assumptions?.length ? [`Help testing: ${pj.assumptions[0]}`] : undefined })}">Create this project on GitHub</a>`;
    }));

    // Ask: short multi-turn chat.
    const history: Msg[] = [];
    $('[data-clear]').addEventListener('click', () => { history.length = 0; $('[data-chat]').innerHTML = ''; });
    $('[data-run="ask"]').addEventListener('click', () => run('Answering', async () => {
      const q = ($('[data-question]') as HTMLTextAreaElement).value.trim();
      if (!q) return;
      ($('[data-question]') as HTMLTextAreaElement).value = '';
      const chat = $('[data-chat]');
      chat.insertAdjacentHTML('beforeend', `<p class="q body-sm">${esc(q)}</p><div class="a body"></div>`);
      const a = chat.lastElementChild as HTMLElement;
      let acc = '';
      const tick = streaming('Answering');
      const reply = await generate([{ role: 'system', content: SYSTEM }, ...history.slice(-6), { role: 'user', content: q }], (t) => { acc += t; tick(); a.innerHTML = fmt(visible(acc)); });
      history.push({ role: 'user', content: q }, { role: 'assistant', content: visible(reply) });
    }));
  }
</script>

<style>
