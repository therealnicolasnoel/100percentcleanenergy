  .lab :global(.ideas) { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--space-3); }
  .lab :global(.idea) { display: grid; gap: var(--space-2); align-content: start; border: var(--stroke-hairline) solid var(--line); border-radius: var(--radius-md); padding: var(--space-3); background: var(--surface-0); }
  .lab :global(.where a) { color: var(--ink-muted); }
  .lab :global(.acts) { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .lab :global(.out) { display: grid; gap: var(--space-2); max-width: 80ch; }
  .lab :global(.out p), .lab :global(.a p) { margin: 0; }
  .lab :global(.out .h), .lab :global(.a .h) { font-weight: 600; margin-top: var(--space-2); }
  .lab :global(.out .li), .lab :global(.a .li) { padding-left: var(--space-4); position: relative; }
  .lab :global(.out .li)::before, .lab :global(.a .li)::before { content: '–'; position: absolute; left: 0; color: var(--ink-muted); }
  .lab :global(.verdict) { display: grid; gap: var(--space-3); border-top: var(--stroke-hairline) solid var(--line); padding-top: var(--space-3); }
  .lab :global(.nums) { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-4); margin: 0; }
  @media (max-width: 900px) { .lab :global(.nums) { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .lab :global(.nums div) { display: grid; gap: 2px; align-content: start; }
  .lab :global(.nums dd) { margin: 0; overflow-wrap: anywhere; }
  .lab :global(.numeral) { font-family: var(--font-mono); font-size: 20px; line-height: 26px; font-weight: 500; }
  .lab :global(.chat) { display: grid; gap: var(--space-2); }
  .lab :global(.q) { justify-self: end; background: var(--surface-2); padding: var(--space-2) var(--space-3); border-radius: var(--radius-md); max-width: 80%; }
