---
/**
 * Monte Carlo scenario simulator for a problem: how likely the goal is by each year
 * with the tracked projects, without them, and under scenarios people set.
 * Rendered at build time with the default scenario; re-run in the browser on change.
 */
import Icon from './Icon.astro';
import { buildModel, simulate, levers, fanChart, headline, pBy, DEFAULT_SCENARIO, HORIZON } from '../lib/simulate';
import type { ProblemData } from '../lib/problemData';
import type { Problem } from '../data/problems';
import { gh } from '../site.config';

interface Props { data: ProblemData; problem: Problem }
const { data, problem } = Astro.props;
const model = buildModel(data);
const TARGETS = [2035, 2040, 2045, 2050, 2060, 2070];
const target = 2050;
const res = simulate(model, DEFAULT_SCENARIO);
const base = simulate(model, { ...DEFAULT_SCENARIO, includeTracked: false });
const lv = levers(model, DEFAULT_SCENARIO, target);
const maxGain = Math.max(0.1, ...lv.map((l) => l.gain));
const pct = (x: number) => `${Math.round(x * 100)}%`;
const yr = (y: number) => (Number.isFinite(y) ? String(Math.round(y)) : `after ${model.start + HORIZON}`);
const tableYears = Array.from({ length: 11 }, (_, i) => 2030 + i * 5);
---
<section class="sim" data-sim data-model={JSON.stringify(model)} data-target={target}>
  <div class="head">
    <div>
      <p class="numeral-xl" data-out="headline">{headline(res)}</p>
      <p class="label muted">Chance of reaching the goal, with the tracked projects (arrival year, {DEFAULT_SCENARIO.runs.toLocaleString('en')} simulated futures)</p>
    </div>
    <p class="body effect" data-out="effect">
      The {data.projects.length} tracked projects raise the chance of reaching it by <span data-out="t1">{target}</span> from <strong class="data" data-out="pWithout">{pct(pBy(base, target))}</strong> to <strong class="data" data-out="pWith">{pct(pBy(res, target))}</strong>.
    </p>
  </div>

  <div class="body-grid">
    <div class="chart-col">
      <div class="chart" data-out="chart" set:html={fanChart(res, base, target)} />
      <p class="legend body-sm muted">
        <span><svg width="22" height="8" aria-hidden="true"><line x1="0" y1="4" x2="22" y2="4" class="l-main" /></svg>With the tracked projects</span>
        <span><svg width="22" height="8" aria-hidden="true"><line x1="0" y1="4" x2="22" y2="4" class="l-cmp" /></svg>Without them</span>
        <span><svg width="14" height="10" aria-hidden="true"><rect width="14" height="10" class="l-b50" /></svg>Middle 50% of arrival years</span>
        <span><svg width="14" height="10" aria-hidden="true"><rect width="14" height="10" class="l-b90" /></svg>Middle 90%</span>
      </p>
      <p class="body-sm muted">Illustrative model. Ranges, not predictions. Lines: chance the goal is reached by each year. Bands: when it arrives, with the tracked projects.</p>
      <details class="tbl">
        <summary class="label">View as table</summary>
        <table>
          <thead><tr><th>By</th>{tableYears.map((y) => <th class="n data">{y}</th>)}</tr></thead>
          <tbody>
            <tr><td class="label">With projects</td>{tableYears.map((y) => <td class="n data" data-cell={`with-${y}`}>{pct(pBy(res, y))}</td>)}</tr>
            <tr><td class="label">Without</td>{tableYears.map((y) => <td class="n data" data-cell={`without-${y}`}>{pct(pBy(base, y))}</td>)}</tr>
          </tbody>
        </table>
      </details>
    </div>

    <form class="controls" data-controls onsubmit="return false">
      <p class="subheading">Scenario</p>
      <label class="label">Target year
        <select name="target">{TARGETS.map((t) => <option value={t} selected={t === target}>{t}</option>)}</select>
      </label>
      <fieldset>
        <legend class="label">How often projects succeed</legend>
        <div class="seg">
          <label><input type="radio" name="success" value="0.6" />Pessimistic</label>
          <label><input type="radio" name="success" value="1" checked />Central</label>
          <label><input type="radio" name="success" value="1.4" />Optimistic</label>
        </div>
      </fieldset>
      <label class="check body-sm"><input type="checkbox" name="tracked" checked /> Include the tracked projects</label>
      <fieldset>
        <legend class="label">Add active projects</legend>
        {model.subs.map((s) => (
          <label class="slider body-sm">
            <span class="sl-top"><span>{s.title}</span><output class="data" data-for={s.id}>+0</output></span>
            <input type="range" min="0" max="20" step="1" value="0" name={`extra-${s.id}`} aria-label={`Extra projects for ${s.title}`} />
            <span class="data-sm muted">{s.tracked} tracked</span>
          </label>
        ))}
      </fieldset>
      <button type="button" class="btn btn-secondary" data-reset>Reset</button>
    </form>
  </div>

  <div class="lower">
    <div class="levers">
      <p class="subheading">Where more projects help most</p>
      <p class="body-sm muted">Gain in the chance of reaching the goal by <span data-out="t2">{target}</span> from five more active projects on each sub-goal, on top of this scenario.</p>
      <div data-out="levers">
        {lv.map((l, i) => (
          <div class="lever">
            <span class="body-sm">{l.title}</span>
            <span class="bar-row"><span class:list={['bar', { top: i === 0 }]} style={`width:${Math.max(1, (Math.max(0, l.gain) / maxGain) * 100)}%`}></span><span class="data">+{l.gain.toFixed(1)} pts</span></span>
          </div>
        ))}
      </div>
    </div>
    <div class="subs">
      <p class="subheading">Sub-goals in this scenario</p>
      <div class="scroll">
        <table>
          <thead><tr><th>Sub-goal</th><th>Estimate without projects</th><th class="n">Median done</th><th class="n">Holds things up</th><th></th></tr></thead>
          <tbody>
            {model.subs.map((s) => {
              const r = res.subs.find((x) => x.id === s.id)!;
              const file = data.nodes[s.id].file!;
              return (
                <tr>
                  <td class="body-sm">{s.title}{s.logic === 'OR' && <span class="muted"> (any one step)</span>}</td>
                  <td class="data">{s.p10}–{s.p90} yrs · {pct(s.pSuccess)} doable</td>
                  <td class="n data" data-cell={`med-${s.id}`}>{yr(r.p50)}</td>
                  <td class="n data" data-cell={`crit-${s.id}`}>{pct(r.critical)}</td>
                  <td><a class="body-sm" href={gh.edit(file)}>Edit</a></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="body-sm muted">"Holds things up": how often the sub-goal is the last to finish. Estimates are years from {model.start}{model.estimated ? '' : ' (some sub-goals have no estimate yet and use 15–45 years)'}.</p>
    </div>
  </div>

  <details class="assume">
    <summary class="label">How the simulator works, and what it assumes</summary>
    <div class="body-sm">
      <p>Each run draws one possible future. The goal is reached when every sub-goal is done; a sub-goal is done when all its steps are, or any one of them when marked "any one". Each sub-goal's time without the tracked projects comes from its estimate (years from {model.start}, P10–P90, and the chance it can be done at all), written by people in the sub-goal file and reviewed like the sub-goals themselves. Steps vary a little around their sub-goal.</p>
      <p>Each project then succeeds or not in that run. A successful project adds effort to its step, and effort shortens the step with diminishing returns: time × (1 + effort ÷ 5)<sup>−elasticity</sup>, where elasticity is set per sub-goal (default 0.3). Effort per project: open-source 0.8 plus a little for stars; startups 2; funded research 1 plus a little for the grant size; people's projects 1.5 when active, 0.6 as ideas. Chance of success: recently active open-source 60%, startups 30%, funded research 50%, people's projects 15–40%. Added projects count as 1.5 effort with a 45% chance. The scenario's success setting scales every chance.</p>
      <p>These are assumptions, not findings. The estimates for problem {problem.number} were drafted by AI and haven't been reviewed: change them in each sub-goal's file.</p>
    </div>
  </details>
</section>

<script>
  import { simulate, levers, fanChart, headline, pBy, DEFAULT_SCENARIO, HORIZON, type SimModel } from '../lib/simulate';
  for (const root of document.querySelectorAll<HTMLElement>('[data-sim]')) {
    const model: SimModel = JSON.parse(root.dataset.model!);
    const form = root.querySelector<HTMLFormElement>('[data-controls]')!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const cell = (k: string) => root.querySelector<HTMLElement>(`[data-cell="${k}"]`);
    const pct = (x: number) => `${Math.round(x * 100)}%`;
    const yr = (y: number) => (Number.isFinite(y) ? String(Math.round(y)) : `after ${model.start + HORIZON}`);
    let timer = 0;
    const run = () => {
      const f = new FormData(form);
      const target = Number(f.get('target'));
      const extra: Record<string, number> = {};
      for (const s of model.subs) {
        const v = Number(f.get(`extra-${s.id}`) ?? 0);
        extra[s.id] = v;
        root.querySelector<HTMLOutputElement>(`output[data-for="${s.id}"]`)!.textContent = `+${v}`;
      }
      const sc = { ...DEFAULT_SCENARIO, includeTracked: f.get('tracked') === 'on', successScale: Number(f.get('success')), extra };
      const res = simulate(model, sc);
      const base = simulate(model, { ...sc, includeTracked: false, extra: {} });
      const showCmp = sc.includeTracked || Object.values(extra).some(Boolean);
      out('headline').textContent = headline(res);
      out('chart').innerHTML = fanChart(res, showCmp ? base : null, target);
      out('t1').textContent = String(target);
      out('t2').textContent = String(target);
      out('pWith').textContent = pct(pBy(res, target));
      out('pWithout').textContent = pct(pBy(base, target));
      for (let y = 2030; y <= 2080; y += 5) { cell(`with-${y}`)!.textContent = pct(pBy(res, y)); cell(`without-${y}`)!.textContent = pct(pBy(base, y)); }
      for (const s of res.subs) { cell(`med-${s.id}`)!.textContent = yr(s.p50); cell(`crit-${s.id}`)!.textContent = pct(s.critical); }
      const lv = levers(model, sc, target);
      const max = Math.max(0.1, ...lv.map((l) => l.gain));
      out('levers').innerHTML = lv.map((l, i) => `<div class="lever"><span class="body-sm">${l.title}</span><span class="bar-row"><span class="bar${i === 0 ? ' top' : ''}" style="width:${Math.max(1, (Math.max(0, l.gain) / max) * 100)}%"></span><span class="data">+${l.gain.toFixed(1)} pts</span></span></div>`).join('');
    };
    form.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(run, 120); });
    root.querySelector('[data-reset]')!.addEventListener('click', () => { form.reset(); run(); });
  }
</script>

<style>
  .sim { display: grid; gap: var(--space-6); }
  .sim > *, .body-grid > *, .lower > *, .controls > *, .controls fieldset > * { min-width: 0; }
  .tbl { overflow-x: auto; }
  .head { display: grid; gap: var(--space-3); }
  .effect { max-width: 70ch; }
  .body-grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: var(--space-6); align-items: start; }
  @media (max-width: 900px) { .body-grid, .lower { grid-template-columns: 1fr !important; } }
  .chart-col { display: grid; gap: var(--space-2); }
  .chart { background: var(--surface-0); border: var(--stroke-hairline) solid var(--line); }
  .chart :global(.grid) { stroke: var(--line); stroke-width: 1; }
  .chart :global(.axis) { stroke: var(--line-strong); stroke-width: 1; }
  .chart :global(.tick) { font-family: var(--font-mono); font-size: 11px; fill: var(--ink-muted); }
  .chart :global(.b90) { fill: var(--viz-band-90); }
  .chart :global(.b50) { fill: var(--viz-band-50); }
  .chart :global(.main) { fill: none; stroke: var(--ink); stroke-width: 2; }
  .chart :global(.cmp) { fill: none; stroke: var(--line-strong); stroke-width: 1.5; stroke-dasharray: 5 4; }
  .chart :global(.median) { stroke: var(--signal); stroke-width: 2; }
  .chart :global(.mlabel) { font-family: var(--font-mono); font-size: 11px; fill: var(--signal); }
  .chart :global(.target) { stroke: var(--ink); stroke-width: 1; stroke-dasharray: 2 3; }
  .chart :global(.tlabel) { font-family: var(--font-mono); font-size: 11px; fill: var(--ink); }
  .chart :global(.lab) { font-family: var(--font-sans); font-size: 11px; fill: var(--ink); }
  .chart :global(.lab.muted) { fill: var(--ink-muted); }
  .legend { display: flex; flex-wrap: wrap; gap: var(--space-4); }
  .legend span { display: inline-flex; gap: var(--space-2); align-items: center; }
  .l-main { stroke: var(--ink); stroke-width: 2; }
  .l-cmp { stroke: var(--line-strong); stroke-width: 1.5; stroke-dasharray: 5 4; }
  .l-b50 { fill: var(--viz-band-50); }
  .l-b90 { fill: var(--viz-band-90); }
  .controls { display: grid; gap: var(--space-4); background: var(--surface-1); border: var(--stroke-hairline) solid var(--line); border-radius: var(--radius-md); padding: var(--space-4); }
  .controls label.label { display: grid; gap: var(--space-1); }
  fieldset { border: 0; margin: 0; padding: 0; display: grid; gap: var(--space-2); min-inline-size: 0; }
  .slider > * { min-width: 0; }
  select { font: inherit; font-size: 14px; color: var(--ink); background: var(--surface-1); border: var(--stroke-hairline) solid var(--line-strong); border-radius: var(--radius-sm); padding: var(--space-1) var(--space-2); }
  .seg { display: flex; border: var(--stroke-hairline) solid var(--line-strong); border-radius: var(--radius-sm); overflow: hidden; }
  .seg label { flex: 1; text-align: center; font-size: 12px; padding: var(--space-1) 0; cursor: pointer; }
  .seg label + label { border-left: var(--stroke-hairline) solid var(--line-strong); }
  .seg input { position: absolute; opacity: 0; }
  .seg label:has(input:checked) { background: var(--ink); color: var(--surface-0); }
  .seg label:has(input:focus-visible) { outline: 2px solid var(--focus); outline-offset: -2px; }
  .check { display: flex; gap: var(--space-2); align-items: center; }
  .slider { display: grid; gap: 2px; }
  .sl-top { display: flex; justify-content: space-between; gap: var(--space-2); }
  .sl-top span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  input[type='range'] { width: 100%; accent-color: var(--ink); }
  .lower { display: grid; grid-template-columns: 1fr 1.4fr; gap: var(--space-8); }
  .levers, .subs { display: grid; gap: var(--space-3); align-content: start; }
  /* Lever rows are re-rendered in the browser, so their styles are global under .levers. */
  .levers :global(.lever) { display: grid; gap: 2px; margin-bottom: var(--space-2); }
  .levers :global(.bar-row) { display: flex; align-items: center; gap: var(--space-2); }
  .levers :global(.bar) { height: 8px; background: var(--ink); border-radius: 0 2px 2px 0; }
  .levers :global(.bar.top) { background: var(--signal); }
  .scroll { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; background: var(--surface-1); }
  th, td { padding: var(--space-2) var(--space-3); border-bottom: var(--stroke-hairline) solid var(--line); text-align: left; vertical-align: top; }
  th { background: var(--surface-2); font-size: 12px; line-height: 16px; font-weight: 500; }
  .n { text-align: right; }
  .tbl summary, .assume summary { cursor: pointer; }
  .tbl table { margin-top: var(--space-2); }
  .assume div { display: grid; gap: var(--space-2); margin-top: var(--space-2); max-width: 90ch; color: var(--ink-muted); }
</style>
