---
// "Who's working on it" is now part of What's happening. Old links land there.
import { activeProblems } from '../../../data/problems';
import { url } from '../../../site.config';

export function getStaticPaths() {
  return activeProblems.map((problem) => ({ params: { slug: problem.slug }, props: { problem } }));
}
const { problem } = Astro.props;
const to = url(`/problems/${problem.slug}/field/#people`);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Moved: What's happening</title>
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
  </head>
  <body><p>This page moved to <a href={to}>What's happening</a>.</p></body>
</html>
