---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProblemHeader from '../../../components/ProblemHeader.astro';
import FieldView from '../../../components/FieldView.astro';
import People from '../../../components/People.astro';
import { activeProblems } from '../../../data/problems';
import { getProblemData } from '../../../lib/problemData';
import { getField } from '../../../lib/field';
import { gh } from '../../../site.config';

export function getStaticPaths() {
  return activeProblems.map((problem) => ({ params: { slug: problem.slug }, props: { problem } }));
}
const { problem } = Astro.props;
const data = await getProblemData(problem);
const field = getField(problem.slug);
---
<BaseLayout title={`What's happening · ${problem.number}. ${problem.title}`}>
  <div class="wide">
    <ProblemHeader problem={problem} current="happening" />
    {data && field ? (
      <FieldView field={field} data={data} problem={problem}>
        <People data={data} problem={problem} field={field} />
      </FieldView>
    ) : data ? (
      <div class="empty">
        <People data={data} problem={problem} field={null} />
        <p class="body-sm muted">No field scan yet. Add <code class="data-sm">problems/{problem.slug}/scan.json</code> (<code class="data-sm">npm run scan:init -- {problem.slug}</code>), then run the "Scan the field" workflow. <a href={gh.tree(`problems/${problem.slug}`)}>Open the problem folder</a></p>
      </div>
    ) : null}
  </div>
</BaseLayout>
<style>
  .wide { max-width: 1600px; margin: 0 auto; padding: 0 var(--space-12); }
  @media (max-width: 720px) { .wide { padding: 0 var(--space-4); } }
  .empty { display: grid; gap: var(--space-6); margin-top: var(--space-6); }
</style>
