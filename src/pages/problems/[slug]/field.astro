---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProblemHeader from '../../../components/ProblemHeader.astro';
import FieldView from '../../../components/FieldView.astro';
import { activeProblems } from '../../../data/problems';
import { getProblemData } from '../../../lib/problemData';
import { getReportsFor } from '../../../lib/reports';
import { getField } from '../../../lib/field';
import { gh } from '../../../site.config';

export function getStaticPaths() {
  return activeProblems.map((problem) => ({ params: { slug: problem.slug }, props: { problem } }));
}
const { problem } = Astro.props;
const data = await getProblemData(problem);
const reports = await getReportsFor(problem);
const field = getField(problem.slug);
---
<BaseLayout title={`State of the field · ${problem.number}. ${problem.title}`}>
  <div class="wide">
    <ProblemHeader problem={problem} current="field" size="l" counts={{ reports: reports.length, steps: data?.order.length, organisations: data?.actors.length }} />
    {data && field ? <FieldView field={field} data={data} problem={problem} /> : (
      <div class="panel" style="margin-top: var(--space-6); display: grid; gap: var(--space-3); justify-items: start">
        <p class="body">This problem hasn't been scanned yet.</p>
        <p class="body-sm muted">The field scanner needs a tree map and <code class="data-sm">problems/{problem.slug}/scan.json</code>. Create one with <code class="data-sm">npm run scan:init -- {problem.slug}</code>, tune its search terms, then run the "Scan the field" workflow on GitHub.</p>
        <a class="btn btn-secondary" href={gh.tree(`problems/${problem.slug}`)}>Open the problem folder</a>
      </div>
    )}
  </div>
</BaseLayout>
<style>
  .wide { max-width: 1600px; margin: 0 auto; padding: 0 var(--space-12); }
  @media (max-width: 720px) { .wide { padding: 0 var(--space-4); } }
</style>
