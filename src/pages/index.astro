---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReviewBadge from '../components/ReviewBadge.astro';
import Icon from '../components/Icon.astro';
import { problems, activeProblems, categories } from '../data/problems';
import { getReports } from '../lib/reports';
import { site, url, formatDate } from '../site.config';

const reports = await getReports();
const countFor = (n: number) => reports.filter((r) => r.data.problem === n).length;
---
<BaseLayout>
  <div class="wrap">
    <section class="hero">
      <h1 class="display-xl">100 problems. Open reports on each, kept in GitHub.</h1>
      <p class="body lede muted">{site.description} We are starting with {activeProblems.length === 1 ? 'one problem' : `${activeProblems.length} problems`}. The rest open as reports arrive.</p>
    </section>

    <section class="open">
      <h2 class="label muted">Open for reports</h2>
      <div class="cards">
        {activeProblems.map((p) => {
          const latest = reports.find((r) => r.data.problem === p.number);
          return (
            <a class="card" href={url(`/problems/${p.slug}/`)}>
              <p class="label muted"><span class="data">Problem {p.number}</span> · {p.category}</p>
              <h3 class="heading">{p.title}</h3>
              {latest?.data.headline && (
                <div>
                  <p class="numeral-xl">{latest.data.headline.value}</p>
                  <p class="label muted">{latest.data.headline.label}</p>
                </div>
              )}
              <div class="row">
                <span class="data muted">{countFor(p.number)} {countFor(p.number) === 1 ? 'report' : 'reports'}</span>
                {latest && <span class="data-sm muted">latest {formatDate(latest.data.date)}</span>}
                {latest && <ReviewBadge status={latest.data.status} reviewers={latest.data.reviewers} />}
              </div>
              <span class="go body-sm">Read and publish reports <Icon name="arrow" size={12} /></span>
            </a>
          );
        })}
      </div>
    </section>

    <section class="all">
      <h2 class="display-l">All 100 problems</h2>
      <p class="body muted">Each problem gets the same page and report layout. Problems that aren't open yet are listed so you can see what's coming.</p>
      <div class="cats">
        {categories.map((c) => (
          <div class="cat">
            <h3 class="subheading">{c}</h3>
            <ol class="list">
              {problems.filter((p) => p.category === c).map((p) => (
                <li class:list={[{ on: p.active }]}>
                  <span class="data num">{p.number}</span>
                  {p.active
                    ? <a class="body-sm" href={url(`/problems/${p.slug}/`)}>{p.title}</a>
                    : <span class="body-sm muted">{p.title}</span>}
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
<style>
  .hero { padding: var(--space-16) 0 var(--space-12); display: grid; gap: var(--space-4); max-width: 820px; }
  @media (max-width: 720px) { .hero h1 { font-size: 32px; line-height: 38px; } .hero { padding: var(--space-12) 0 var(--space-8); } }
  .lede { max-width: 62ch; }
  .open { display: grid; gap: var(--space-3); }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--space-6); }
  .card { display: grid; gap: var(--space-3); background: var(--surface-1); border: var(--stroke-hairline) solid var(--line); border-radius: var(--radius-md); padding: var(--space-4); color: var(--ink); text-decoration: none; }
  .card:hover { border-color: var(--line-strong); color: var(--ink); }
  .card:hover .go { text-decoration: underline; }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .go { color: var(--signal); display: inline-flex; align-items: center; gap: var(--space-1); }
  .all { margin-top: var(--space-16); display: grid; gap: var(--space-3); }
  .cats { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: var(--space-8) var(--space-6); margin-top: var(--space-6); }
  .cat { border-top: var(--stroke-hairline) solid var(--line); padding-top: var(--space-3); }
  .list { list-style: none; padding: 0; margin: var(--space-2) 0 0; display: grid; gap: var(--space-1); }
  .list li { display: grid; grid-template-columns: 28px 1fr; gap: var(--space-2); padding: var(--space-1) 0; }
  .list li.on { background: var(--signal-tint); margin: 0 calc(-1 * var(--space-2)); padding: var(--space-1) var(--space-2); border-radius: var(--radius-sm); }
  .list li.on a { color: var(--ink); font-weight: 600; }
  .num { color: var(--ink-muted); text-align: right; }
</style>
