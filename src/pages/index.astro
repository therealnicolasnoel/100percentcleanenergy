---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { problems, activeProblems, categories } from '../data/problems';
import { getProblemData } from '../lib/problemData';
import { buildModel, simulate, pBy, DEFAULT_SCENARIO } from '../lib/simulate';
import { site, url, gh } from '../site.config';

// Each open problem's card: the chance by 2050 with today's projects, and what holds it back.
const overview = Object.fromEntries(await Promise.all(activeProblems.map(async (p) => {
  const d = await getProblemData(p);
  if (!d) return [p.number, null];
  const r = simulate(buildModel(d), DEFAULT_SCENARIO);
  const worst = r.subs.reduce((a, b) => (b.critical > a.critical ? b : a));
  return [p.number, { p: pBy(r, 2050), blocker: d.nodes[worst.id].title, projects: d.projects.length }];
})));
const waiting = problems.length - activeProblems.length;
---
<BaseLayout>
  <div class="wrap">
    <section class="hero">
      <h1 class="display-xl">The world's hardest problems, and the projects moving them.</h1>
      <p class="body lede muted">For each problem: what to do next, the plan from goal to projects, and who is working on it. Everything is open and lives in GitHub.</p>
    </section>

    <section class="open">
      {activeProblems.map((p) => {
        const o = overview[p.number];
        return (
          <a class="card" href={url(`/problems/${p.slug}/`)}>
            <p class="label muted"><span class="data">Problem {p.number}</span> · {p.category}</p>
            <h2 class="heading">{p.title}</h2>
            {o && (
              <p class="body">
                <strong class="data big">{Math.round(o.p * 100)}%</strong> chance by 2050 with today's {o.projects} projects. Biggest blocker: {o.blocker}.
              </p>
            )}
            <span class="go body-sm">See what to do next <Icon name="arrow" size={12} /></span>
          </a>
        );
      })}
    </section>

    <p class="next body-sm muted">
      {waiting} more problems open one at a time, across {categories.slice(0, 4).join(', ').toLowerCase()} and more. <a href={gh.blob('src/data/problems.ts')}>See the full list</a>.
    </p>
  </div>
</BaseLayout>
<style>
  .hero { padding: var(--space-16) 0 var(--space-12); display: grid; gap: var(--space-4); max-width: 820px; }
  @media (max-width: 720px) { .hero h1 { font-size: 32px; line-height: 38px; } .hero { padding: var(--space-12) 0 var(--space-8); } }
  .lede { max-width: 62ch; }
  .open { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--space-6); max-width: 820px; }
  .card { display: grid; gap: var(--space-3); background: var(--surface-1); border: var(--stroke-hairline) solid var(--line); border-radius: var(--radius-md); padding: var(--space-6); color: var(--ink); text-decoration: none; }
  .card:hover { border-color: var(--line-strong); color: var(--ink); }
  .card:hover .go { text-decoration: underline; }
  .big { font-size: 20px; font-weight: 500; }
  .go { color: var(--signal); display: inline-flex; align-items: center; gap: var(--space-1); }
  .next { margin-top: var(--space-8); max-width: 820px; }
</style>
